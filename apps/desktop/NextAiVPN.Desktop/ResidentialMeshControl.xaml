<UserControl x:Class="NextAiVPN.ResidentialMeshControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             FontFamily="{DynamicResource MuseoSans500FontFamily}"
             FontSize="12"
             Foreground="{DynamicResource Color2E2E33}"
             Background="{DynamicResource BrushBgSubtle}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
    <StackPanel Orientation="Vertical" MaxWidth="800" HorizontalAlignment="Left">
      
      <!-- HEADER BANNER -->
      <Border Background="#FFFFFF" BorderBrush="{DynamicResource BrushBorderEmerald}" BorderThickness="1.5" CornerRadius="12" Padding="18" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          
          <StackPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="🌐 Residential Mesh Gateway &amp; KikiLogin Hub" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald900}" />
              <Border Margin="10,0,0,0" Padding="6,2" Background="{DynamicResource BrushEmerald100}" CornerRadius="6" VerticalAlignment="Center">
                <TextBlock Text="PORT 10000 ACTIVE" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald700}" />
              </Border>
            </StackPanel>
            <TextBlock Text="Route Antidetect Browser profiles (KikiLogin, AdsPower, GoLogin) directly through local Universal Gateway port 10000." FontSize="12" Foreground="{DynamicResource Color6D6E70}" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Gateway Badge -->
          <Border Grid.Column="1" Background="{DynamicResource BrushEmerald50}" BorderBrush="{DynamicResource BrushBorderEmerald}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="16,0,0,0" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="UNIVERSAL GATEWAY" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald700}" HorizontalAlignment="Center" Margin="0,0,0,2" />
              <TextBlock Text="127.0.0.1:10000" FontFamily="Consolas, Monospace" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald900}" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- GATEWAY STATUS & TELEMETRY ROW -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Card 1: Decoupling Law -->
        <Border Grid.Column="0" Margin="0,0,8,0" Background="#FFFFFF" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="14">
          <StackPanel>
            <TextBlock Text="🛡️ Decoupling Law" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushEmerald900}" Margin="0,0,0,4" />
            <TextBlock Text="100% Isolated. Zero Windows Proxy tampering (ProxyEnable = 0). Zero DNS/IPv6 leaks." FontSize="11" Foreground="{DynamicResource Color6D6E70}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Card 2: Proxy Protocol -->
        <Border Grid.Column="1" Margin="4,0,4,0" Background="#FFFFFF" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="14">
          <StackPanel>
            <TextBlock Text="⚡ Protocol Support" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushEmerald900}" Margin="0,0,0,4" />
            <TextBlock Text="SOCKS5 + HTTP Proxy enabled concurrently on port 10000. Dedicated range 10001-10500." FontSize="11" Foreground="{DynamicResource Color6D6E70}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Card 3: Mesh Quota -->
        <Border Grid.Column="2" Margin="8,0,0,0" Background="#FFFFFF" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="14">
          <StackPanel>
            <TextBlock Text="📊 Pool Health" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushEmerald900}" Margin="0,0,0,4" />
            <TextBlock Text="18 Active Residential Nodes online. Auto-Failover &amp; Latency Optimizer active." FontSize="11" Foreground="{DynamicResource Color6D6E70}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- ACTIVE CLIENT NODES SECTION -->
      <TextBlock Text="ACTIVE MESH CLIENT NODES &amp; KIKILOGIN SYNTAX" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald900}" Margin="0,4,0,10" />

      <!-- Node Item 1 -->
      <Border Background="#FFFFFF" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <Border Width="18" Height="18" CornerRadius="9" ClipToBounds="True" BorderBrush="#20000000" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                <Image RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" Source="/Resources/Flags/us.png" />
              </Border>
              <TextBlock Text="Client Node: win_c0a8019b (Primary Desktop)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Color2A2A2C}" VerticalAlignment="Center" />
              <Border Margin="10,0,0,0" Padding="6,1" Background="{DynamicResource BrushEmerald100}" CornerRadius="4" VerticalAlignment="Center">
                <TextBlock Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald700}" />
              </Border>
            </StackPanel>
            <Border Background="{DynamicResource BrushBgSubtle}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
              <TextBlock Text="127.0.0.1:10000:node-win_c0a8019b:nextai123" FontFamily="Consolas, Monospace" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushEmerald900}" />
            </Border>
            <TextBlock Text="Protocol: SOCKS5 • IP Egress: 192.111.130.5 (USA Atlanta) • Latency: 38ms" FontSize="10.5" Foreground="{DynamicResource Color6D6E70}" />
          </StackPanel>
          <Button Grid.Column="1" x:Name="BtnCopyNode1" Margin="12,0,0,0" Padding="12,6" Height="34" VerticalAlignment="Center" Background="{DynamicResource BrushEmerald600}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" Click="BtnCopyNode1_Click">
            <Button.Resources>
              <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="6"/>
              </Style>
            </Button.Resources>
            Copy KikiLogin
          </Button>
        </Grid>
      </Border>

      <!-- Node Item 2 -->
      <Border Background="#FFFFFF" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <Border Width="18" Height="18" CornerRadius="9" ClipToBounds="True" BorderBrush="#20000000" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                <Image RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" Source="/Resources/Flags/us.png" />
              </Border>
              <TextBlock Text="Client Node: win_89fe121a (Laptop Gateway)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Color2A2A2C}" VerticalAlignment="Center" />
              <Border Margin="10,0,0,0" Padding="6,1" Background="{DynamicResource BrushEmerald100}" CornerRadius="4" VerticalAlignment="Center">
                <TextBlock Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald700}" />
              </Border>
            </StackPanel>
            <Border Background="{DynamicResource BrushBgSubtle}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
              <TextBlock Text="127.0.0.1:10000:node-win_89fe121a:nextai123" FontFamily="Consolas, Monospace" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushEmerald900}" />
            </Border>
            <TextBlock Text="Protocol: HTTP • IP Egress: 34.43.46.91 (USA New York) • Latency: 45ms" FontSize="10.5" Foreground="{DynamicResource Color6D6E70}" />
          </StackPanel>
          <Button Grid.Column="1" x:Name="BtnCopyNode2" Margin="12,0,0,0" Padding="12,6" Height="34" VerticalAlignment="Center" Background="{DynamicResource BrushEmerald600}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" Click="BtnCopyNode2_Click">
            <Button.Resources>
              <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="6"/>
              </Style>
            </Button.Resources>
            Copy KikiLogin
          </Button>
        </Grid>
      </Border>

      <!-- Node Item 3 -->
      <Border Background="#FFFFFF" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <Border Width="18" Height="18" CornerRadius="9" ClipToBounds="True" BorderBrush="#20000000" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                <Image RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" Source="/Resources/Flags/vn.png" />
              </Border>
              <TextBlock Text="Client Node: vn_hanoi_vnpt (Vietnam Residential Hub)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Color2A2A2C}" VerticalAlignment="Center" />
              <Border Margin="10,0,0,0" Padding="6,1" Background="{DynamicResource BrushEmerald100}" CornerRadius="4" VerticalAlignment="Center">
                <TextBlock Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald700}" />
              </Border>
            </StackPanel>
            <Border Background="{DynamicResource BrushBgSubtle}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
              <TextBlock Text="127.0.0.1:10000:node-vn_hanoi_vnpt:nextai123" FontFamily="Consolas, Monospace" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushEmerald900}" />
            </Border>
            <TextBlock Text="Protocol: SOCKS5 • IP Egress: 14.251.13.20 (Hanoi VNPT) • Latency: 12ms" FontSize="10.5" Foreground="{DynamicResource Color6D6E70}" />
          </StackPanel>
          <Button Grid.Column="1" x:Name="BtnCopyNode3" Margin="12,0,0,0" Padding="12,6" Height="34" VerticalAlignment="Center" Background="{DynamicResource BrushEmerald600}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" Click="BtnCopyNode3_Click">
            <Button.Resources>
              <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="6"/>
              </Style>
            </Button.Resources>
            Copy KikiLogin
          </Button>
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
