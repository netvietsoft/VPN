<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.Account.PopUp.SubscriptionExpireSoonControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:popUp="clr-namespace:NextAiVPN.UI.Feedback.PopUp" Width="414" Height="190" Style="{DynamicResource MainPanelNotificationUserControlStyle}" xmlns:popup="clr-namespace:NextAiVPN.UI.Account.PopUp" Visibility="{Binding Path=UserControlVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
  <StackPanel>
    <Border BorderBrush="{DynamicResource ColorF4F4F5}" BorderThickness="0.1">
      <UIElement.Effect>
        <DropShadowEffect ShadowDepth="-2" Color="{DynamicResource DropShadowColor}" />
      </UIElement.Effect>
    </Border>
    <StackPanel Name="FeedbackTopPanel" VerticalAlignment="Top" Orientation="Horizontal">
      <Image Name="MessageImage" Width="35" Height="35" Margin="15,0,0,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" Style="{DynamicResource SubscriptionExpireSoonImageStyle}" />
      <StackPanel Orientation="Vertical">
        <TextBlock Width="314" Margin="10,18,0,18" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" FontWeight="SemiBold" Style="{DynamicResource GeneralExpendedTextBlockStyle}" Text="Subscription expires soon" />
        <StackPanel>
          <TextBlock Width="236" Margin="10,-15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="{DynamicResource MuseoSans400FontFamily}" Style="{DynamicResource ProtocolInfoTextBlockStyle}" Text="Keep your device secure by automatically renewing NextAiVPN." TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
      <Image Name="FeedbackClose" Height="25" Margin="-5,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource XCloseButtonWindowImageStyle}">
        <b:Interaction.Triggers>
          <b:EventTrigger EventName="MouseDown">
            <b:InvokeCommandAction Command="{Binding CloseButtonClickCommand}" />
          </b:EventTrigger>
        </b:Interaction.Triggers>
      </Image>
    </StackPanel>
    <StackPanel Name="FeedbackBottomPanel" HorizontalAlignment="Center" Orientation="Vertical">
      <Button Width="300" Height="32" Margin="0,12,0,0" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Content="Renew Subscription" Style="{DynamicResource ActiveButtonStyle}" Command="{Binding TurnOnClickCommand}" />
      <Button Width="300" Height="32" Margin="0,12,0,12" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Content="Cancel" Style="{DynamicResource WhiteButtonStyle}" Command="{Binding CancelClickCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>