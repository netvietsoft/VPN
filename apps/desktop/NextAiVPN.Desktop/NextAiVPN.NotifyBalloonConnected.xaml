<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.NotifyBalloonConnected" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:nextaivpn="clr-namespace:NextAiVPN;assembly=NextAiVPN">
  <Grid Width="385" Height="120" Style="{DynamicResource NotificationBackgroundGridStyle}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0.15*" />
      <ColumnDefinition Width="0.85*" />
    </Grid.ColumnDefinitions>
    <Image Name="BalloonIcon" Grid.Column="0" Width="25" Height="25" Margin="0,30,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Source="/Assets/Notification-connected.png" />
    <StackPanel Grid.Column="1" Width="240" Height="60" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
      <TextBlock Name="txtTitle" Width="100" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="{DynamicResource MuseoSans600FontFamily}" FontSize="20" FontWeight="Bold" Style="{DynamicResource NotificationTextHeaderForegroundTextBlockStyle}" Text="Success!" />
      <TextBlock Name="txtLine1" VerticalAlignment="Top" FontFamily="{DynamicResource MuseoSans400FontFamily}" FontSize="14" Style="{DynamicResource NotificationTextForegroundTextBlockStyle}" Text="Now enjoy private, secure" />
      <TextBlock Name="txtLine2" VerticalAlignment="Top" FontFamily="{DynamicResource MuseoSans400FontFamily}" FontSize="14" Style="{DynamicResource NotificationTextForegroundTextBlockStyle}" Text="browsing with NextAiVPN" />
    </StackPanel>
  </Grid>
</UserControl>