<?xml version="1.0" encoding="utf-8"?>
<!--
  [VI] Giao diện Cài đặt Tổng quan NextAiVPN chuẩn Clean Emerald Edition.
  [EN] Clean Emerald Edition Settings Control with structured card grouping and uniform right-aligned toggles.
-->
<UserControl x:Class="NextAiVPN.UI.Settings.ExpandedNextAiVpnSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:nextaitechnologyVpn="clr-namespace:NextAiVPN"
             xmlns:settings="clr-namespace:NextAiVPN.UI.Settings">
  <Grid Margin="20,16,20,16">
    <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="ScrollViewer_OnPreviewMouseWheel">
      <StackPanel Orientation="Vertical" MaxWidth="720" HorizontalAlignment="Left">
        
        <!-- STREAMING WARNING BANNER (CONDITIONAL) -->
        <Border Name="StreamingInfoBorder" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="28" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="General settings are disabled in Streaming Mode" FontWeight="Bold" FontSize="12.5" Foreground="#92400E" />
              <TextBlock Text="Streaming servers use specialized dedicated routing. Switch to Standard mode to customize security rules." FontSize="11" Foreground="#B45309" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel Name="PreferencesPanel" Orientation="Vertical">
          
          <!-- CARD GROUP 1: SECURITY & CONNECTION RULES -->
          <Border Background="#FFFFFF" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,0,0,14">
            <StackPanel Orientation="Vertical">
              
              <!-- Group Header -->
              <DockPanel LastChildFill="False" Margin="0,0,0,12">
                <TextBlock Text="🛡️ Security &amp; Connection Protection" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald900}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <Border Background="{DynamicResource BrushEmerald100}" CornerRadius="6" Padding="6,2" DockPanel.Dock="Right" VerticalAlignment="Center">
                  <TextBlock Text="CORE DEFENSE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald800}" />
                </Border>
              </DockPanel>

              <!-- Row 1: Kill Switch -->
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Kill Switch (Always-On Fail-Safe)" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" />
                  <TextBlock Text="Instantly cuts all internet traffic if VPN disconnects unexpectedly to prevent IP leaks." FontSize="11.5" Foreground="{DynamicResource Color6D6E70}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <nextaitechnologyVpn:ToggleSwitch x:Name="KillSwitchToggle" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Width="65" Height="25" MouseLeftButtonDown="KillSwitchToggle_OnMouseLeftButtonDown" />
              </Grid>

              <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,10" />

              <!-- Row 2: Auto-Protect -->
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Auto-Protect on Wi-Fi" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" />
                  <TextBlock Text="Automatically activates VPN whenever your device joins an unknown or public Wi-Fi." FontSize="11.5" Foreground="{DynamicResource Color6D6E70}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <nextaitechnologyVpn:ToggleSwitch x:Name="AutoProtectToggle" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Width="65" Height="25" MouseLeftButtonDown="AutoProtectToggle_OnMouseLeftButtonDown" />
              </Grid>

              <!-- Row 3: Network Detection Notification (Conditional) -->
              <StackPanel Name="AutoProtectNotificationStackPanel" Margin="0,0,0,0">
                <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,10" />
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Network Detection Notifications" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" />
                    <TextBlock Text="Displays a notification alert when connecting to new or unverified networks." FontSize="11.5" Foreground="{DynamicResource Color6D6E70}" TextWrapping="Wrap" Margin="0,2,0,0" />
                  </StackPanel>
                  <nextaitechnologyVpn:ToggleSwitch x:Name="NetworkDetectionNotificationToggle" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Width="65" Height="25" MouseLeftButtonDown="NetworkDetectionNotificationToggle_OnMouseLeftButtonDown" />
                </Grid>
              </StackPanel>

              <!-- Row 4: Trusted Networks -->
              <StackPanel Name="TrustedNetworksStackPanel">
                <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,10" />
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Trusted Wi-Fi Networks" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" />
                    <TextBlock Text="All home or office Wi-Fi networks marked as trusted will bypass auto-connect rules." FontSize="11.5" Foreground="{DynamicResource Color6D6E70}" TextWrapping="Wrap" Margin="0,2,0,0" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="{DynamicResource BrushEmerald50}" BorderBrush="{DynamicResource BrushBorderEmerald}" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Cursor="Hand" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald700}" Text="See All Networks ↗" MouseLeftButtonDown="SeeAll_OnMouseLeftButtonDown" />
                  </Border>
                </Grid>
              </StackPanel>

            </StackPanel>
          </Border>

          <!-- CARD GROUP 2: TRAFFIC & APP CONTROL -->
          <Border Background="#FFFFFF" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,0,0,14">
            <StackPanel Orientation="Vertical">
              
              <!-- Group Header -->
              <DockPanel LastChildFill="False" Margin="0,0,0,12">
                <TextBlock Text="🚀 Traffic, Apps &amp; Device Routing" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald900}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <Border Background="{DynamicResource BrushEmerald100}" CornerRadius="6" Padding="6,2" DockPanel.Dock="Right" VerticalAlignment="Center">
                  <TextBlock Text="CUSTOM RULES" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald800}" />
                </Border>
              </DockPanel>

              <!-- Row 1: Split Tunneling -->
              <StackPanel Name="SplitTunnelingStackPanel">
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Split Tunneling" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" />
                    <TextBlock Text="Choose which specific apps or domains bypass VPN for direct local internet speed." FontSize="11.5" Foreground="{DynamicResource Color6D6E70}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Name="ManageSplitTunnelingTextBlock" Cursor="Hand" Margin="0,4,0,0" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="11.5" Foreground="{DynamicResource BrushEmerald600}" Text="⚙️ Configure App &amp; Domain Routes ↗" MouseLeftButtonDown="Manage_OnMouseLeftButtonDown" />
                  </StackPanel>
                  <nextaitechnologyVpn:ToggleSwitch x:Name="SplitTunnelingToggle" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Width="65" Height="25" MouseLeftButtonDown="SplitTunnelingToggle_OnMouseLeftButtonDown" />
                </Grid>
              </StackPanel>

              <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,10" />

              <!-- Row 2: Ad Blocker -->
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Ad &amp; Malware Blocker" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" />
                  <TextBlock Text="Blocks intrusive advertisements, tracking scripts, and malicious phishing websites." FontSize="11.5" Foreground="{DynamicResource Color6D6E70}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <nextaitechnologyVpn:ToggleSwitch x:Name="AdBlockerToggle" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Width="65" Height="25" MouseLeftButtonDown="AdBlockerToggle_OnMouseLeftButtonDown" />
              </Grid>

              <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,10" />

              <!-- Row 3: Traffic Optimizer -->
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Traffic Optimizer" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" />
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="Accelerate latency for selected games &amp; streaming apps. Manage " FontSize="11.5" Foreground="{DynamicResource Color6D6E70}" />
                    <TextBlock Cursor="Hand" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="11.5" Foreground="{DynamicResource BrushEmerald600}" Text="here ↗" PreviewMouseDown="TrafficOptimizerLink_PreviewMouseDown" />
                  </StackPanel>
                </StackPanel>
                <nextaitechnologyVpn:ToggleSwitch x:Name="TrafficOptimizer" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Width="65" Height="25" MouseLeftButtonDown="TrafficOptimizer_OnMouseLeftButtonDown" />
              </Grid>

              <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,10" />

              <!-- Row 4: Allow LAN -->
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Control Access to Local LAN Devices" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" />
                  <TextBlock Text="Allows communicating with printers, network drives, and smart IoT devices on your local network." FontSize="11.5" Foreground="{DynamicResource Color6D6E70}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <nextaitechnologyVpn:ToggleSwitch x:Name="AllowLan" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Width="65" Height="25" MouseLeftButtonDown="AllowLan_OnMouseLeftButtonDown" />
              </Grid>

            </StackPanel>
          </Border>

          <!-- CARD GROUP 3: LEAK PROTECTION & DNS -->
          <Border Background="#FFFFFF" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,0,0,14">
            <StackPanel Orientation="Vertical">
              
              <!-- Group Header -->
              <DockPanel LastChildFill="False" Margin="0,0,0,12">
                <TextBlock Text="🔒 Advanced DNS &amp; Leak Prevention" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald900}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <Border Background="{DynamicResource BrushEmerald100}" CornerRadius="6" Padding="6,2" DockPanel.Dock="Right" VerticalAlignment="Center">
                  <TextBlock Text="DNS SHIELD" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald800}" />
                </Border>
              </DockPanel>

              <!-- Row 1: IPv6 Leak Protection -->
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="IPv6 Leak Protection" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" />
                  <TextBlock Text="Routes or blocks IPv6 packets to prevent non-VPN network identity leakage." FontSize="11.5" Foreground="{DynamicResource Color6D6E70}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <nextaitechnologyVpn:ToggleSwitch x:Name="IPv6LeakProtection" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Width="65" Height="25" MouseLeftButtonDown="IPv6LeakProtection_OnMouseLeftButtonDown" />
              </Grid>

              <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,10" />

              <!-- Row 2: DNS Leak Protection -->
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="DNS Leak Protection" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" />
                  <TextBlock Text="Forces all system DNS queries to be resolved exclusively inside the encrypted tunnel." FontSize="11.5" Foreground="{DynamicResource Color6D6E70}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <nextaitechnologyVpn:ToggleSwitch x:Name="DnsLeakProtection" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Width="65" Height="25" MouseLeftButtonDown="DnsLeakProtection_OnMouseLeftButtonDown" />
              </Grid>

              <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,10" />

              <!-- Row 3: DNS Monitoring -->
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="DNS Integrity &amp; Query Monitoring" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" />
                  <TextBlock Text="Inspects real-time DNS transactions to detect malicious DNS hijacking or spoofing." FontSize="11.5" Foreground="{DynamicResource Color6D6E70}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <nextaitechnologyVpn:ToggleSwitch x:Name="DnsMonitoring" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Width="65" Height="25" MouseLeftButtonDown="DnsMonitoring_OnMouseLeftButtonDown" />
              </Grid>

            </StackPanel>
          </Border>

          <!-- Hidden compatibility control for legacy references -->
          <nextaitechnologyVpn:ExpandedProtocolSettings x:Name="ProtocolsControl" Visibility="Collapsed" />

        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>