<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.Streaming.Locations.StreamingLocations" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:noLocation="clr-namespace:NextAiVPN.UI.Streaming.NoLocation" xmlns:streaming="clr-namespace:NextAiVPN.Entities.Streaming;assembly=NextAiVPN.Streaming" xmlns:ui="clr-namespace:NextAiVPN.UI" xmlns:locations="clr-namespace:NextAiVPN.UI.Streaming.Locations">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Name="MainGridRow0" Height="40" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:LocationsListHeader x:Name="LocationsListHeader" Height="40" />
    <Separator Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Foreground="#FFD3D3D3" Opacity="0.2" />
    <Grid Row="1">
      <noLocation:NoStreamingLocations x:Name="NoStreamingLocationsControl" />
      <ListBox Name="LocationsList" Width="559" Height="Auto" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0" FontFamily="{DynamicResource MuseoSans500FontFamily}" IsEnabled="True" ItemContainerStyle="{DynamicResource LocationListBoxItemStyle}" RenderTransformOrigin="0.316,0.472" ScrollViewer.VerticalScrollBarVisibility="Hidden" ItemsSource="{Binding Locations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type streaming:IStreamingLocation}">
            <StackPanel Name="LocationMainGrid" Width="520" Orientation="Horizontal" VirtualizingPanel.IsVirtualizing="False">
              <Image Name="CountryFlag" Width="20" Height="20" Margin="0,0,0,0" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5" Source="{Binding Path=CountryCode, Converter={StaticResource StreamingCountryCodeToFlagConverter}}" />
              <TextBlock Name="CountryFullName" Width="298" Margin="10,2,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="16" FontWeight="Normal" Style="{DynamicResource LocationListBoxItemsTextForegroundTextBlockStyle}" Text="{Binding Path=Country, Converter={StaticResource CountryCodeToFullCountryNameConverter}}">
                <UIElement.InputBindings>
                  <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ConnectToCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}" />
                </UIElement.InputBindings>
              </TextBlock>
              <TextBlock Width="298" Margin="25,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="12" FontWeight="Normal" Style="{DynamicResource LocationListBoxItemsTextForegroundTextBlockStyle}" Text="{Binding Path=PingMs, Converter={StaticResource StreamingPingConverter}}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        <b:Interaction.Triggers>
          <b:EventTrigger EventName="SelectionChanged">
            <b:InvokeCommandAction Command="{Binding SelectedItemChangedCommand}" CommandParameter="{Binding ElementName=LocationsList, Path=SelectedItem}" />
          </b:EventTrigger>
        </b:Interaction.Triggers>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>