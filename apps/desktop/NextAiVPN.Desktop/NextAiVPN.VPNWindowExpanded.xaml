<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NextAiVPN.VPNWindowExpanded"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NextAiVPN"
        xmlns:account="clr-namespace:NextAiVPN.UI.Account"
        xmlns:getHelp="clr-namespace:NextAiVPN.UI.GetHelp"
        xmlns:loginError="clr-namespace:NextAiVPN.UI.Errors.LoginError"
        xmlns:preferences="clr-namespace:NextAiVPN.UI.Preferences"
        xmlns:settings="clr-namespace:NextAiVPN.UI.Settings"
        xmlns:termsAndPolicies="clr-namespace:NextAiVPN.UI.TermsAndPolicies"
        Title="NextAi VPN &amp; Gateway Client"
        Width="1100"
        Height="680"
        FontFamily="{DynamicResource MuseoSans500FontFamily}"
        FontSize="12"
        Foreground="{DynamicResource Color2E2E33}"
        Background="{DynamicResource BrushBgSubtle}"
        Icon="/Assets/vpn_icon.ico"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        IsVisibleChanged="Window_IsVisibleChanged"
        KeyDown="VPNWindowExpanded_OnKeyDown"
        Loaded="VPNWindowExpanded_OnLoaded"
        MouseLeftButtonDown="VPNWindowExpanded_OnMouseLeftButtonDown"
        PreviewMouseDown="VPNWindowExpanded_OnPreviewMouseDown">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="42" GlassFrameThickness="0" CornerRadius="0" />
  </WindowChrome.WindowChrome>
  <DockPanel LastChildFill="True">
    <!-- TOP TITLEBAR -->
    <Border DockPanel.Dock="Top" Style="{DynamicResource WindowHeaderBorderStyle}">
      <local:WindowHeader x:Name="WindowHeader" />
    </Border>

    <!-- MAIN BODY: 2 COLUMNS (Sidebar 220px + Content Viewport *) -->
    <Grid Name="MainGrid" Background="{DynamicResource BrushBgSubtle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="228" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- COLUMN 0: SIDEBAR -->
      <local:ExpandedSideMenu x:Name="ExpandedSideMenu" Grid.Column="0" />

      <!-- COLUMN 1: MAIN CONTENT VIEWPORT -->
      <Grid Grid.Column="1" Margin="0">
        <!-- View 1: Dashboard (Default) -->
        <local:ExpandedMainPanel x:Name="Mainpanel" Visibility="Visible" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- View 2: Locations -->
        <local:ExpandedLocations x:Name="ExpandedLocations" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- View 3: Residential Mesh Gateway & KikiLogin Hub -->
        <local:ResidentialMeshControl x:Name="ResidentialMeshControl" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- View 4: Speed Test & Latency Benchmark -->
        <local:SpeedTestControl x:Name="SpeedTestControl" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- View 5: Settings -->
        <settings:SettingsMainControl x:Name="GeneralControl" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- View 6: Protocols -->
        <local:ExpandedProtocolSettings x:Name="ProtocolsControl" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- View 7: Account & Plans -->
        <account:ExpandedAccount x:Name="AccountControl" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- View 8: Notifications -->
        <local:NotificationCenterExpanded x:Name="NotificationCenter" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- View 9: Logs -->
        <local:ExpandedLogsView x:Name="AdvanceViewLogs" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- View 10: Help & Support -->
        <getHelp:ExpandedGetHelp x:Name="GetHelpControl" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- View 11: Terms & Legal -->
        <termsAndPolicies:ExpandedTermsAndPolicies x:Name="TermsAndPoliciesControl" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Supporting Panels -->
        <preferences:PreferencesControl x:Name="Preferences" Visibility="Collapsed" />
        <loginError:LoginError x:Name="LoginError" Visibility="Collapsed" />
        <local:NoNetwork_Control x:Name="NoNetworkExpanded" Visibility="Collapsed" />
        <Image Name="BrandImage" Visibility="Collapsed" />
      </Grid>
    </Grid>
  </DockPanel>
</Window>