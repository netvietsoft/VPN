<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NextAiVPN.InstallMessage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:nextaitechnologyVpn="clr-namespace:NextAiVPN" Title="" Width="386" Height="312" Icon="/Assets/vpn_icon.ico" ResizeMode="NoResize" Style="{DynamicResource {x:Type Window}}" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="34" />
  </WindowChrome.WindowChrome>
  <DockPanel>
    <nextaitechnologyVpn:WindowHeader x:Name="WindowHeader" DockPanel.Dock="Top" />
    <Grid>
      <StackPanel>
        <TextBlock Name="MessageTitle" Margin="0,55,0,0" HorizontalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="20" FontWeight="Medium" Style="{DynamicResource InstallMessageTextblockHeaderForegroundStyle}" Text="Almost there!" />
        <TextBlock Name="MessageContent" Width="260" Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="16" LineHeight="20" Style="{DynamicResource InstallMessageTextblockForegroundStyle}" Text="Please install the required TAPdriver in order to use OpenVPN" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Name="CustomerLink" Width="290" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="16" Foreground="{DynamicResource Color074DB2}" Text="Customer Support" TextAlignment="Center" TextDecorations="Underline" TextWrapping="Wrap" Visibility="Collapsed" MouseLeftButtonDown="CustomerLink_MouseLeftButtonDown" />
        <Button Name="btnInstall" Width="208" Height="48" Margin="0,30,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Content="Install" FontSize="20" Style="{DynamicResource PrimaryRoundedButtonStyle}" Click="Button_Click" />
      </StackPanel>
      <Image Name="btnInstallSpinner" Width="24" Height="24" Margin="0,0,0,75" HorizontalAlignment="Center" VerticalAlignment="Bottom" Source="/Assets/spinner_white.png" Visibility="Collapsed" />
    </Grid>
  </DockPanel>
</Window>