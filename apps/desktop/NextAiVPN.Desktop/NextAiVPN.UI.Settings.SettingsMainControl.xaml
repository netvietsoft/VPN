<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.Settings.SettingsMainControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:NextAiVPN.UI.Settings" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Visibility="{Binding ControlVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
  <Grid IsEnabled="{Binding MainGridIsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Opacity="{Binding MainGridOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="40" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Rectangle Grid.RowSpan="3" Panel.ZIndex="990" Fill="#00FFFFFF" IsEnabled="False" Opacity="0.4" Visibility="{Binding DisablerRectangleVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Grid.Row="0" Margin="16,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="20" Style="{DynamicResource DefaultTextBlockForegroundStyle}" Text="Settings" />
    <Separator Grid.Row="0" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Foreground="#FFD3D3D3" Opacity="0.2" />
    <StackPanel Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal">
      <Border Name="GeneralSettingsBorder" Height="40" Margin="20,0,0,0" BorderThickness="0,0,0,1" Style="{DynamicResource StreamingModesButtonLocationTabBorderStyle}" MouseLeftButtonDown="GeneralSettingsBorder_OnMouseLeftButtonDown">
        <TextBlock Name="GeneralTextBlock" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="14" Style="{DynamicResource StreamingModesButtonLocationTabTextStyle}" Text="General" />
        <b:Interaction.Triggers>
          <b:EventTrigger EventName="MouseLeftButtonDown">
            <b:InvokeCommandAction Command="{Binding GeneralBorderClickCommand}" CommandParameter="{Binding ElementName=GeneralModeBorder}" />
          </b:EventTrigger>
        </b:Interaction.Triggers>
      </Border>
      <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
        <Border Name="AdvancedSettingsBorder" Height="40" BorderThickness="0,0,0,1" Style="{DynamicResource StreamingModesButtonLocationTabBorderStyle}" Visibility="{Binding AdvancedSettingsHeaderBorderVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MouseLeftButtonDown="AdvancedSettingsBorder_OnMouseLeftButtonDown">
          <TextBlock Name="AdvancedTextBlock" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="14" Style="{DynamicResource StreamingModesButtonLocationTabTextStyle}" Text="Streaming" />
          <b:Interaction.Triggers>
            <b:EventTrigger EventName="MouseLeftButtonDown">
              <b:InvokeCommandAction Command="{Binding AdvancedBorderClickCommand}" />
            </b:EventTrigger>
          </b:Interaction.Triggers>
        </Border>
      </StackPanel>
    </StackPanel>
    <Separator Grid.Row="1" Width="Auto" Margin="0,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Foreground="#FFD3D3D3" Opacity="0.2" />
    <Grid Row="2" Visibility="{Binding Path=GeneralSettingsControlVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
      <local:ExpandedGeneralSettingsControl x:Name="GeneralSettingsControl" />
    </Grid>
    <Grid Row="2" Visibility="{Binding Path=AdvancedSettingsControlVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
      <local:ExpandedStreamingSettingsControl x:Name="StreamingSettingsControl" />
    </Grid>
  </Grid>
</UserControl>