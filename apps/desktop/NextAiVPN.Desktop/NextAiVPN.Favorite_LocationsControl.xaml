<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.Favorite_LocationsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" BorderBrush="#FF000000" BorderThickness="0.3" Style="{DynamicResource FavoriteLocationsUserControlStyle}" xmlns:nextaivpn="clr-namespace:NextAiVPN;assembly=NextAiVPN">
  <Control.Template>
    <ControlTemplate TargetType="{x:Type UserControl}">
      <Border Style="{DynamicResource FavoriteBorderTemplateStyle}">
        <ContentPresenter Content="{TemplateBinding ContentControl.Content}" />
      </Border>
    </ControlTemplate>
  </Control.Template>
  <Grid>
    <StackPanel ZIndex="999" Orientation="Vertical">
      <ListBox Name="BestAvailable" Margin="0,5" BorderThickness="0" ItemContainerStyle="{DynamicResource LocationListBoxItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Style="{DynamicResource FavoriteStreamingLocationListboxStyle}" PreviewMouseDown="BestAvailable_OnMouseDown">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <Image Name="flagImage" Width="24" Height="24" Margin="6,0,0,0" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Source>
                  <MultiBinding Converter="{StaticResource CountryCityCodesToFlagConverter}" UpdateSourceTrigger="PropertyChanged">
                    <Binding Path="CountryCode" />
                    <Binding Path="CityCode" />
                  </MultiBinding>
                </Image.Source>
                <UIElement.RenderTransform>
                  <RotateTransform x:Name="TransRotate" Angle="0" CenterX="0" CenterY="0" />
                </UIElement.RenderTransform>
                <FrameworkElement.Resources>
                  <ResourceDictionary />
                </FrameworkElement.Resources>
              </Image>
              <TextBlock Width="298" Margin="15,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="16" FontWeight="Normal" Style="{DynamicResource LocationHeaderDefaultForegroundTextBlockStyle}" Text="{Binding Converter={StaticResource BestAvailableConverter}}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ListBox>
      <StackPanel Name="LocationsStackPanel">
        <Separator Name="firstSeparator" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Top" Foreground="{StaticResource ColorDBDBE3}" Opacity="0.2" />
        <TextBlock Margin="15,5,0,0" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="10" Opacity="0.4" Style="{DynamicResource LocationHeaderDefaultForegroundTextBlockStyle}" Text="FAVORITES" />
        <ListBox Name="FavoritesList" Margin="0,3,0,10" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Style="{DynamicResource FavoriteLocationListboxStyle}" SelectionChanged="FavoritesList_SelectionChanged">
          <ItemsControl.ItemContainerStyle>
            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="{x:Type ListBoxItem}">
              <Setter Property="Height" Value="40" />
              <Setter Property="Width" Value="273" />
              <Setter Property="Background" Value="#00FFFFFF" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="VerticalAlignment" Value="Center" />
              <Style.Resources>
                <ResourceDictionary>
                  <Style x:Key="{x:Type Border}" TargetType="{x:Type Border}">
                    <Setter Property="Border.CornerRadius" Value="25" />
                  </Style>
                </ResourceDictionary>
              </Style.Resources>
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Background" Value="{StaticResource ColorE6F7FF}" />
                  <Setter Property="BorderThickness" Value="0" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Image Name="flagImage" Width="24" Height="24" Margin="6,3,0,0" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                  <Image.Source>
                    <MultiBinding Converter="{StaticResource CountryCityCodesToFlagConverter}" UpdateSourceTrigger="PropertyChanged">
                      <Binding Path="CountryCode" />
                      <Binding Path="CityCode" />
                    </MultiBinding>
                  </Image.Source>
                  <UIElement.RenderTransform>
                    <RotateTransform x:Name="TransRotate" Angle="0" CenterX="0" CenterY="0" />
                  </UIElement.RenderTransform>
                  <FrameworkElement.Resources>
                    <ResourceDictionary />
                  </FrameworkElement.Resources>
                </Image>
                <TextBlock Name="LocationHeader" Width="298" Margin="15,3,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" FontWeight="Normal" Style="{DynamicResource LocationHeaderDefaultForegroundTextBlockStyle}" Text="{Binding Converter={StaticResource FavoriteLocationConverter}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ListBox>
        <Separator Name="secondSeparator" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Top" Foreground="{StaticResource ColorDBDBE3}" Opacity="0.2" />
        <StackPanel Name="AddMoreSection" Height="45" Orientation="Horizontal" MouseLeftButtonUp="AddMoreSection_MouseLeftButtonUp">
          <Image Width="24" Height="24" Margin="15,10" HorizontalAlignment="Left" Source="/Assets/addFavorite.png" />
          <TextBlock Name="AddMore" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="16" Style="{DynamicResource AddNewFavoriteForegroundTextBlockStyle}" Text="Add new favorite" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>