<?xml version="1.0" encoding="utf-8"?>
<!--
  [VI] Giao diện Cài đặt Giao thức VPN (Protocols) chuẩn Clean Emerald Edition.
  [EN] Clean Emerald Edition Protocol Settings Control with structured cards.
-->
<UserControl x:Class="NextAiVPN.ExpandedProtocolSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:nextaivpn="clr-namespace:NextAiVPN;assembly=NextAiVPN"
             Style="{DynamicResource {x:Type UserControl}}">
  <Grid Name="ProtocolsGrid" Margin="20,16,20,16">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Vertical" MaxWidth="720" HorizontalAlignment="Left">
        
        <!-- HEADER BANNER CARD -->
        <Border Background="#FFFFFF" BorderBrush="{DynamicResource BrushBorderEmerald}" BorderThickness="1.5" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="🔒 VPN Protocols &amp; Encryption Engine" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald900}" />
                <Border Margin="10,0,0,0" Padding="6,2" Background="{DynamicResource BrushEmerald100}" CornerRadius="6" VerticalAlignment="Center">
                  <TextBlock Text="MULTI-TUNNEL" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald700}" />
                </Border>
              </StackPanel>
              <TextBlock Text="Select a protocol that balances your security, encryption strength, and speed requirements." FontSize="11.5" Foreground="{DynamicResource Color6D6E70}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- PROTOCOL 1: IKEv2 CARD -->
        <Border Background="#FFFFFF" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
          <StackPanel>
            <DockPanel LastChildFill="False">
              <RadioButton Name="IKEv2" Content="IKEv2 / IPsec" GroupName="Protocols" Style="{DynamicResource RadioButtonStyle}" Checked="IKEv2_Checked" DockPanel.Dock="Left" VerticalAlignment="Center" />
              <Border Background="{DynamicResource BrushEmerald50}" BorderBrush="{DynamicResource BrushBorderEmerald}" BorderThickness="1" CornerRadius="6" Padding="6,2" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="STABLE MOBILITY" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald700}" />
              </Border>
            </DockPanel>
            <TextBlock Margin="30,6,0,0" FontSize="11.5" LineHeight="17" Foreground="{DynamicResource Color6D6E70}" Text="Secure, stable, and highly resilient when switching between Wi-Fi and mobile networks." TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <StackPanel Name="OtherProtocolsPanel">
          <!-- PROTOCOL 2: WIREGUARD CARD -->
          <Border Background="#FFFFFF" BorderBrush="{DynamicResource BrushBorderEmerald}" BorderThickness="1.5" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
              <DockPanel LastChildFill="False">
                <RadioButton Name="WireGuard" Content="WireGuard® (Recommended)" GroupName="Protocols" Style="{DynamicResource RadioButtonStyle}" Checked="WireGuard_OnChecked" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <Border Background="{DynamicResource BrushEmerald100}" CornerRadius="6" Padding="6,2" DockPanel.Dock="Right" VerticalAlignment="Center">
                  <TextBlock Text="⚡ ULTRA FAST • MODERN CRYPTO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald800}" />
                </Border>
              </DockPanel>
              <TextBlock Margin="30,6,0,0" FontSize="11.5" LineHeight="17" Foreground="{DynamicResource Color6D6E70}" Text="State-of-the-art cryptography (ChaCha20-Poly1305), instant handshake, minimal overhead, and maximum throughput." TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- PROTOCOL 3: OPENVPN CARD WITH ENCLOSED SUB-OPTIONS -->
          <Border Background="#FFFFFF" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
              <DockPanel LastChildFill="False">
                <RadioButton Name="OpenVPN" Content="OpenVPN" GroupName="Protocols" Style="{DynamicResource RadioButtonStyle}" Checked="OpenVPN_Checked" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <Border Background="#F1F5F9" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="6,2" DockPanel.Dock="Right" VerticalAlignment="Center">
                  <TextBlock Text="ADVANCED STEALTH" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Color6D6E70}" />
                </Border>
              </DockPanel>
              <TextBlock Margin="30,6,0,0" FontSize="11.5" LineHeight="17" Foreground="{DynamicResource Color6D6E70}" Text="Industry gold-standard protocol. Provides maximum configurability, DPI bypass obfuscation, and robust desktop support." TextWrapping="Wrap" />

              <!-- SUB-CARD CONTAINER FOR OPENVPN OPTIONS -->
              <DockPanel Name="OpenVPNOptions" IsEnabled="False" Margin="30,12,0,0">
                <Border Background="#F8FAFC" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16,12" HorizontalAlignment="Stretch">
                  <StackPanel Orientation="Vertical">
                    <TextBlock Text="OPENVPN SUB-CONFIGURATION" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald700}" Margin="0,0,0,10" />

                    <!-- TCP Option -->
                    <StackPanel Margin="0,0,0,10">
                      <RadioButton Name="TCP" Content="TCP Mode" Style="{DynamicResource RadioButtonStyle}" Checked="TCP_Checked" />
                      <TextBlock Margin="30,3,0,0" FontSize="11" Foreground="{DynamicResource Color6D6E70}" Text="High reliability &amp; guaranteed packet delivery through strict firewalls." />
                    </StackPanel>

                    <!-- UDP Option -->
                    <StackPanel Margin="0,0,0,10">
                      <RadioButton Name="UDP" Content="UDP Mode (Faster)" Style="{DynamicResource RadioButtonStyle}" Checked="UDP_Checked" />
                      <TextBlock Margin="30,3,0,0" FontSize="11" Foreground="{DynamicResource Color6D6E70}" Text="Best throughput and lowest latency when streaming, downloading, or gaming." />
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,4,0,10" />

                    <!-- Scramble Obfuscation Checkbox -->
                    <StackPanel Margin="0,0,0,10">
                      <CheckBox Name="scramble" Content="Enable Scramble (DPI Obfuscation Layer)" Style="{DynamicResource CheckBoxStyle}" Click="Scramble_Click" />
                      <TextBlock Name="line1" Margin="30,3,0,0" FontSize="11" LineHeight="16" Foreground="{DynamicResource Color6D6E70}" Text="Adds XOR obfuscation to bypass deep packet inspection (DPI) and sensor blocks." TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- TAP Driver Action Link -->
                    <Border Background="#FFFFFF" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,4,0,0" HorizontalAlignment="Left">
                      <TextBlock Name="installdriver" Cursor="Hand" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="11.5" Foreground="{DynamicResource BrushEmerald600}" Text="⚙️ Install / Reinstall OpenVPN TAP Driver" MouseLeftButtonUp="InstallDriver_MouseLeftButtonUp" />
                    </Border>

                  </StackPanel>
                </Border>
              </DockPanel>

            </StackPanel>
          </Border>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>