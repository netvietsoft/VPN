<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NextAiVPN.UI.Errors.ErrorWindow.ErrorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="" Width="386" Height="336" Icon="/Assets/vpn_icon.ico" ResizeMode="NoResize" Style="{DynamicResource {x:Type Window}}" WindowStartupLocation="CenterScreen" xmlns:errorwindow="clr-namespace:NextAiVPN.UI.Errors.ErrorWindow;assembly=NextAiVPN">
  <Grid>
    <StackPanel>
      <Image Width="40" Height="40" Margin="0,20,0,0" HorizontalAlignment="Center" Source="/Assets/error.png" />
      <TextBlock Name="ErrorTitle" Margin="0,15,0,0" HorizontalAlignment="Center" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="20" FontWeight="Medium" Style="{DynamicResource NewUserControlTextblockHeaderForegroundStyle}" Text="{Binding Path=MainHeader, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Name="ErrorDescription" Margin="0,3,0,0" HorizontalAlignment="Center" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="20" Style="{DynamicResource NewUserControlTextblockHeaderForegroundStyle}" Text="{Binding Path=SubHeader, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Name="ErrorContent" Width="290" Margin="0,25,0,0" HorizontalAlignment="Stretch" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="16" Style="{DynamicResource NewUserControlTextblockForegroundStyle}" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding Path=Message, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
      <Button Name="btnDismiss" Width="208" Height="48" Margin="0,35,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Content="Got it" FontSize="20" Style="{DynamicResource PrimaryRoundedButtonStyle}" Command="{Binding GotItButtonClickCommand}" />
    </StackPanel>
  </Grid>
</Window>