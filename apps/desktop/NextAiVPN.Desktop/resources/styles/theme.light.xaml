            <TextBlock Name="WatermarkTextBlock" Padding="5,0,0,0" Foreground="{DynamicResource Gray}" IsHitTestVisible="False" Text="Search" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger SourceName="InnerTextBox" Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="WatermarkTextBlock" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="InnerTextBox" Property="Text" Value="">
              <Setter TargetName="WatermarkTextBlock" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
