<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.ToggleSwitch" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Width="180" Height="70" xmlns:nextaivpn="clr-namespace:NextAiVPN;assembly=NextAiVPN">
  <Viewbox Margin="0,0,0,0">
    <Grid Width="288" Height="Auto" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Label Name="StatusLabel" Margin="-3,6,0,5" HorizontalAlignment="Left" VerticalAlignment="Center" Content="OFF" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="45" FontWeight="Medium" Foreground="{DynamicResource Orange}" Visibility="Hidden" />
      <Rectangle Name="Back" Width="160" Height="100" Margin="0,1,4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource ColorBFBFBF}" RadiusX="45" RadiusY="45" MouseLeftButtonDown="Back_MouseLeftButtonDown" />
      <Ellipse Name="Dot" Width="55" Height="55" Margin="0,17,19,18" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{DynamicResource White}" MouseLeftButtonDown="Dot_MouseLeftButtonDown_1" />
    </Grid>
  </Viewbox>
</UserControl>