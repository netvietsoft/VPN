<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.NotifyBalloons.NotifyBalloon" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:notifyballoons="clr-namespace:NextAiVPN.UI.NotifyBalloons;assembly=NextAiVPN" Visibility="{Binding Path=UserControlVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
  <Grid Style="{DynamicResource NotificationBackgroundGridStyle}" Width="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0.15*" />
      <ColumnDefinition Width="0.85*" />
    </Grid.ColumnDefinitions>
    <Image Grid.Column="1" Width="25" Height="25" Margin="58,0,-204,72" Style="{DynamicResource XCloseButtonWindowImageStyle}">
      <b:Interaction.Triggers>
        <b:EventTrigger EventName="MouseDown">
          <b:InvokeCommandAction Command="{Binding CloseButtonClickCommand}" />
        </b:EventTrigger>
      </b:Interaction.Triggers>
    </Image>
    <Image Grid.Column="0" Width="25" Height="25" Margin="0,20,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" Source="{Binding Path=ImageSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <StackPanel Grid.Column="1" Width="240" Height="auto" Margin="10,-15,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
      <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="{DynamicResource MuseoSans600FontFamily}" FontSize="20" FontWeight="Bold" Style="{DynamicResource NotificationTextHeaderForegroundTextBlockStyle}" TextWrapping="Wrap" Text="{Binding Path=Header, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock VerticalAlignment="Top" FontFamily="{DynamicResource MuseoSans400FontFamily}" FontSize="14" Style="{DynamicResource NotificationTextForegroundTextBlockStyle}" TextWrapping="Wrap" Text="{Binding Path=Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
  </Grid>
</UserControl>