<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NextAiVPN.UI.TrafficOptimizer.TrafficOptimizerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:entities="clr-namespace:NextAiVPN.Entities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="TrafficOptimizerWindow" Width="360" Icon="/Assets/NextAiVPN/vpn_icon.ico" ResizeMode="NoResize" Style="{DynamicResource DeleteLogsMessageWindowBackgroundStyle}" WindowStartupLocation="CenterScreen" xmlns:trafficoptimizer="clr-namespace:NextAiVPN.UI.TrafficOptimizer" Height="{Binding WindowHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding WindowVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" />
  </WindowChrome.WindowChrome>
  <Grid>
    <Grid Margin="15" HorizontalAlignment="Right" VerticalAlignment="Top">
      <Ellipse Width="25" Height="25" Style="{DynamicResource EllipseHoverStyle}" />
      <Image Style="{DynamicResource XCloseButtonWindowImageStyle}" />
      <b:Interaction.Triggers>
        <b:EventTrigger EventName="MouseLeftButtonDown">
          <b:InvokeCommandAction Command="{Binding CloseButtonClickCommand}" />
        </b:EventTrigger>
      </b:Interaction.Triggers>
    </Grid>
    <Grid Margin="30">
      <Grid.RowDefinitions>
        <RowDefinition Height="60" MaxHeight="60" />
        <RowDefinition Height="*" />
        <RowDefinition Height="50" MaxHeight="50" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0">
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" Style="{DynamicResource GeneralExpendedTextBlockStyle}" Text="{Binding Title}" />
        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Left" FontSize="12" LineHeight="19" Style="{DynamicResource ProtocolInfoTextBlockStyle}" TextWrapping="Wrap" Text="{Binding Description}" />
      </StackPanel>
      <Grid Row="1" Visibility="{Binding RectangleVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="43*" />
          <ColumnDefinition Width="257*" />
        </Grid.ColumnDefinitions>
        <b:Interaction.Triggers>
          <b:EventTrigger EventName="MouseLeftButtonDown">
            <b:InvokeCommandAction Command="{Binding AddAppCommand}" />
          </b:EventTrigger>
        </b:Interaction.Triggers>
        <Rectangle Grid.ColumnSpan="2" Height="70" Fill="#00FFFFFF" Stroke="{DynamicResource ColorDCDCDF}" StrokeDashArray="4 4" StrokeThickness="1" />
        <StackPanel Grid.Column="1" Margin="55,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
          <TextBlock Style="{DynamicResource ProtocolInfoTextBlockStyle}" Text="None selected yet" />
          <TextBlock HorizontalAlignment="Center" Style="{DynamicResource LinksTextBlockStyle}" Text="Add" />
        </StackPanel>
      </Grid>
      <Grid Row="1" Margin="0,-10,0,0" Visibility="{Binding AppListVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
        <StackPanel Orientation="Vertical">
          <Separator Width="Auto" />
          <ListBox Width="Auto" Height="Auto" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden" Style="{DynamicResource SplitTunnelingListboxBackgroundStyle}" ItemsSource="{Binding AppList}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type entities:TrafficOptimizerApp}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="258" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Image Grid.Column="0" Width="13.3" Height="13.3" HorizontalAlignment="Left" Style="{DynamicResource SplitTunnelingDomainsCheckImageStyle}" />
                  <TextBlock Grid.Column="1" Margin="3,2,0,0" FontSize="14" Style="{DynamicResource TrustedNetworkTextBlockStyle}" Width="{Binding ListBoxWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Text="{Binding Name, Mode=OneWay}">
                    <FrameworkElement.ToolTip>
                      <ToolTip Style="{DynamicResource SplitTunnelingListItemToolTipStyle}" ToolTip="{Binding Path=Path, Mode=OneWay}" />
                    </FrameworkElement.ToolTip>
                  </TextBlock>
                  <Image Name="RemoveApp" Grid.Column="2" Style="{DynamicResource DeleteTrustedNetworkImageStyle}" Margin="{Binding DataContext.RemoveAppItemMargin, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}">
                    <b:Interaction.Triggers>
                      <b:EventTrigger EventName="MouseLeftButtonDown">
                        <b:InvokeCommandAction Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}" />
                      </b:EventTrigger>
                    </b:Interaction.Triggers>
                  </Image>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Grid>
      <Grid Row="2">
        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Left" Style="{DynamicResource LinksTextBlockStyle}" Text="Add more" Visibility="{Binding AppListVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <b:Interaction.Triggers>
            <b:EventTrigger EventName="MouseLeftButtonDown">
              <b:InvokeCommandAction Command="{Binding AddAppCommand}" />
            </b:EventTrigger>
          </b:Interaction.Triggers>
        </TextBlock>
        <Button Width="68" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom" Content="Done" Style="{DynamicResource OkButtonBindingTextStyle}" Command="{Binding CloseButtonClickCommand}" />
      </Grid>
    </Grid>
  </Grid>
</Window>