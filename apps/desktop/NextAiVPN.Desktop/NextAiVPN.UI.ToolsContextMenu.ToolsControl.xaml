<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.ToolsContextMenu.ToolsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Width="25" Height="25" xmlns:toolscontextmenu="clr-namespace:NextAiVPN.UI.ToolsContextMenu;assembly=NextAiVPN">
  <Grid>
    <Image Name="Tools" Grid.Row="0" Width="25" Height="25" HorizontalAlignment="Right" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" Source="/Assets/i-icon.png" Stretch="Uniform" Visibility="Visible" MouseDown="Tools_OnMouseDown">
      <FrameworkElement.ContextMenu>
        <ContextMenu Name="IconContextMenu" Placement="Left" IsOpen="{Binding IsContextMenuOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <MenuItem Height="29" Command="{Binding CustomerSupportCommand}" Visibility="{Binding CustomerSupportVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <HeaderedItemsControl.Header>
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource SettingsContextMenuTextBlockStyle}" Text="Customer Support" />
            </HeaderedItemsControl.Header>
          </MenuItem>
          <MenuItem Height="29" Command="{Binding SignOutCommand}" Visibility="{Binding SignOutVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <HeaderedItemsControl.Header>
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource SettingsContextMenuTextBlockStyle}" Text="Sign Out" />
            </HeaderedItemsControl.Header>
          </MenuItem>
          <MenuItem Height="29" Command="{Binding QuitCommand}">
            <HeaderedItemsControl.Header>
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource SettingsContextMenuTextBlockStyle}" Text="Quit" />
            </HeaderedItemsControl.Header>
          </MenuItem>
        </ContextMenu>
      </FrameworkElement.ContextMenu>
      <b:Interaction.Triggers>
        <b:EventTrigger EventName="PreviewMouseDown">
          <b:InvokeCommandAction Command="{Binding ToolsMouseDownCommand}" />
        </b:EventTrigger>
      </b:Interaction.Triggers>
    </Image>
  </Grid>
</UserControl>