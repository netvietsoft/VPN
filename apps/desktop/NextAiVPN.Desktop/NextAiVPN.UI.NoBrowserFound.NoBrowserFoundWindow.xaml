<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NextAiVPN.UI.NoBrowserFound.NoBrowserFoundWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="InstallWebView2RuntimeWindow" Width="380" Height="160" ResizeMode="NoResize" Style="{DynamicResource DeleteLogsMessageWindowBackgroundStyle}" WindowStartupLocation="CenterScreen" WindowStyle="None" xmlns:nobrowserfound="clr-namespace:NextAiVPN.UI.NoBrowserFound;assembly=NextAiVPN">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" />
  </WindowChrome.WindowChrome>
  <DockPanel>
    <Grid>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Width="Auto" Height="24" Margin="24,25,0,0" HorizontalAlignment="Left" FontSize="20" Style="{DynamicResource DeleteLogsMessageWindowTextBlockHeaderForegroundStyle}" TextWrapping="Wrap" Text="{Binding TitleText, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
          <Image Width="25" Height="25" Margin="10,10,0,10" HorizontalAlignment="Right" Style="{DynamicResource XCloseButtonWindowImageStyle}">
            <b:Interaction.Triggers>
              <b:EventTrigger EventName="MouseDown">
                <b:InvokeCommandAction Command="{Binding CloseXButtonClickCommand}" />
              </b:EventTrigger>
            </b:Interaction.Triggers>
          </Image>
        </StackPanel>
        <TextBlock Width="Auto" Height="Auto" Margin="24,7,0,0" HorizontalAlignment="Left" FontSize="14" Style="{DynamicResource DeleteLogsMessageWindowTextBlockForegroundStyle}" TextWrapping="Wrap" Text="{Binding BodyText, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
        <StackPanel Margin="16,25,16,0" HorizontalAlignment="Center" Background="#00FFFFFF" Orientation="Horizontal">
          <Button Width="330" Height="32" Margin="2,0,0,0" Content="Open guide" Style="{DynamicResource OkButtonBindingTextStyle}" Command="{Binding AgreeButtonClickCommand}" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>