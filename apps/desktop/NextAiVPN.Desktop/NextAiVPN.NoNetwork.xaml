<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NextAiVPN.NoNetwork" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:nextaitechnologyVpn="clr-namespace:NextAiVPN" Title="NextAiVPN" Width="425" Height="675" Icon="/Assets/vpn_icon.ico" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Closing="Window_Closing" Loaded="Window_Loaded">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="34" />
  </WindowChrome.WindowChrome>
  <DockPanel>
    <nextaitechnologyVpn:WindowHeader x:Name="WindowHeader" DockPanel.Dock="Top" />
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="0.15*" />
        <RowDefinition Height="0.9*" />
      </Grid.RowDefinitions>
      <Image Grid.RowSpan="2" Stretch="UniformToFill" Style="{DynamicResource NoNetworkImageBackgroundStyle}" />
      <Image Name="ExpandCollapse" Width="45" Height="45" Margin="0,21,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.72" Source="/Assets/btnExpand.png" Visibility="Collapsed" MouseEnter="ExpandCollapse_MouseEnter" MouseLeave="ExpandCollapse_MouseLeave" MouseLeftButtonUp="ExpandCollapse_MouseLeftButtonUp" />
      <Border Name="GearBorder" Grid.Row="0" Width="38" Height="38" Margin="0,13,14,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource Black}" CornerRadius="19" Opacity="0.12" Visibility="Collapsed" />
      <Grid Row="1" Width="420" Height="250" Margin="0,50,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Image Grid.Row="1" Width="42" Height="42" Margin="0,65,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Source="/Assets/error-white.png" />
        <TextBlock Grid.Row="1" Margin="0,130,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="32" Foreground="{DynamicResource White}" Text="No network detected" />
        <TextBlock Grid.Row="1" Width="350" Margin="0,175,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" Foreground="{DynamicResource White}" LineHeight="23" Text="Please ensure you have internet connection." TextAlignment="Center" TextWrapping="WrapWithOverflow" />
      </Grid>
    </Grid>
  </DockPanel>
</Window>