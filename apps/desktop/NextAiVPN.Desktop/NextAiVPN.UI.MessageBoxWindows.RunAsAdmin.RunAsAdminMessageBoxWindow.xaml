<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NextAiVPN.UI.MessageBoxWindows.RunAsAdmin.RunAsAdminMessageBoxWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Width="350" Height="160" Style="{DynamicResource DeleteLogsMessageWindowBackgroundStyle}" Topmost="True" WindowStartupLocation="CenterScreen" WindowStyle="None" xmlns:runasadmin="clr-namespace:NextAiVPN.UI.MessageBoxWindows.RunAsAdmin;assembly=NextAiVPN">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" />
  </WindowChrome.WindowChrome>
  <Grid>
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Width="Auto" Height="24" Margin="24,25,0,0" HorizontalAlignment="Left" FontSize="20" Style="{DynamicResource DeleteLogsMessageWindowTextBlockHeaderForegroundStyle}" Text="{Binding Header, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
        <Image Name="btnCross" Width="25" Height="25" Margin="280,10,0,10" Style="{DynamicResource XCloseButtonWindowImageStyle}">
          <b:Interaction.Triggers>
            <b:EventTrigger EventName="MouseDown">
              <b:InvokeCommandAction Command="{Binding CloseClickCommand}" CommandParameter="{Binding ElementName=TrustedNetworkControl}" />
            </b:EventTrigger>
          </b:Interaction.Triggers>
        </Image>
      </StackPanel>
      <TextBlock Width="Auto" Height="Auto" Margin="24,7,0,0" HorizontalAlignment="Left" FontSize="12" Style="{DynamicResource DeleteLogsMessageWindowTextBlockForegroundStyle}" Text="{Binding Description, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
      <StackPanel Margin="16,25,16,0" HorizontalAlignment="Center" Background="#00FFFFFF" Orientation="Horizontal">
        <Button Width="134" Height="32" Margin="0,0,2,0" Content="Cancel" Style="{DynamicResource CancelButtonBindingTextStyle}" Command="{Binding CancelClickCommand}" />
        <Button Width="134" Height="32" Margin="2,0,0,0" Content="Ok" Style="{DynamicResource OkButtonBindingTextStyle}" Command="{Binding OkClickCommand}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>