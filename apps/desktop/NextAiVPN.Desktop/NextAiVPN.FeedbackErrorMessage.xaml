<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.FeedbackErrorMessage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:nextaivpn="clr-namespace:NextAiVPN;assembly=NextAiVPN">
  <Grid Height="60">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0.1*" />
      <ColumnDefinition Width="0.9*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="0.6*" />
      <RowDefinition Height="0.5*" />
    </Grid.RowDefinitions>
    <Image Grid.Row="0" Grid.Column="0" Width="14" Height="14" Margin="5,0,5,0" VerticalAlignment="Bottom" Source="/Assets/error.png" />
    <TextBlock Name="ErrorLine1" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="14" Foreground="{DynamicResource ColorFE4E4F}" Text="Unable to send your feedback. Please check your Internet connection and try again." TextWrapping="Wrap" />
  </Grid>
</UserControl>