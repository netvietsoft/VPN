<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.ExpandedLogsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:NextAiVPN" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Style="{DynamicResource {x:Type UserControl}}" IsVisibleChanged="UserControl_IsVisibleChanged" Loaded="UserControl_Loaded">
  <Grid>
    <StackPanel>
      <StackPanel Width="Auto" Height="56" Orientation="Horizontal">
        <TextBlock Margin="24,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="20" Style="{DynamicResource DefaultTextBlockForegroundStyle}" Text="Log Details" />
        <Grid Name="DeleteLogsGrid" Width="40" Height="40" Margin="390,0,0,0" MouseEnter="Deletelogsgrid_MouseEnter" MouseLeave="Deletelogsgrid_MouseLeave">
          <Ellipse Name="deleteEllipse" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#00FFFFFF" Visibility="Visible" />
          <Image Name="deleteLogsImage" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource IconTrashBinFullHeaderImageStyle}" MouseDown="DeleteLogsImage_MouseDown" />
        </Grid>
      </StackPanel>
      <Separator Name="separatorTitle" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Top" Foreground="#FFD3D3D3" Opacity="0.2" />
      <StackPanel>
        <Grid Margin="24,24,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.80*" />
            <ColumnDefinition Width="0.17*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="0.5*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Column="0" Margin="0,0,0,0" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" Style="{DynamicResource DefaultTextBlockForegroundStyle}" Text="Track your user behavior" />
          <local:ToggleSwitch x:Name="LogsSwitch" MouseLeftButtonUp="LogsSwitch_MouseLeftButtonUp" Grid.Column="1" Width="65" Height="25" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="1" Margin="0,0,0,0" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="12" LineHeight="18" Style="{DynamicResource ProtocolInfoTextBlockStyle}" Text="Help improve your troubleshooting experience by privately turning on user tracking logs. They will be visible only to you." TextWrapping="Wrap" />
        </Grid>
      </StackPanel>
      <StackPanel Height="36" Orientation="Horizontal">
        <Label Margin="20,7,0,0" VerticalAlignment="Top" Content="DATA CONSUMPTION" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="10" Style="{DynamicResource DefaultLabelHeaderForegroundStyle}" />
        <Border Height="20" CornerRadius="10" Style="{DynamicResource LogDetailBorderBackgroundStyle}">
          <StackPanel Orientation="Horizontal">
            <Label Name="BytesINTitle" Margin="8,0,0,0" Padding="0,5,0,5" VerticalAlignment="Center" Content="DOWNLOAD" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="10" Style="{DynamicResource LogDetailStaticticLabelBorderedForegroundStyle}" />
            <Label Name="BytesINValue" Margin="4,0,8,0" Padding="0,5,0,5" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="10" Style="{DynamicResource DefaultLabelHeaderForegroundStyle}" Content="{Binding networkUsageDownloadMB}" />
          </StackPanel>
        </Border>
        <Border Height="20" Margin="3,0,0,0" CornerRadius="10" Style="{DynamicResource LogDetailBorderBackgroundStyle}">
          <StackPanel Orientation="Horizontal">
            <Label Name="BytesOUTTitle" Margin="8,0,0,0" Padding="0,5,0,5" VerticalAlignment="Center" Panel.ZIndex="1" Content="UPLOAD" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="10" Style="{DynamicResource LogDetailStaticticLabelBorderedForegroundStyle}" />
            <Label Name="BytesOUTValue" Margin="4,0,8,0" Padding="0,5,0,5" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="10" Style="{DynamicResource DefaultLabelHeaderForegroundStyle}" Content="{Binding networkUsageUploadMB}" />
          </StackPanel>
        </Border>
      </StackPanel>
      <Grid Width="540" Height="455" HorizontalAlignment="Center">
        <ScrollViewer Name="logsScroll" Margin="3,0,10,0" IsEnabled="True" VerticalScrollBarVisibility="Hidden">
          <ListBox Name="logsText" Width="527" Height="455" BorderThickness="0.5" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Visible" Style="{DynamicResource LogListboxBackgroundStyle}" ItemsSource="{Binding}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0.3" Orientation="Horizontal">
                  <TextBlock Margin="0,0,4,0" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="12" Style="{DynamicResource NoLogInformationForegroundTextBlockStyle}" Text="{Binding LogDate}" />
                  <TextBlock Margin="4,0,0,0" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="12" Style="{DynamicResource NoLogInformationForegroundTextBlockStyle}" Text="{Binding LogInfo}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>
        </ScrollViewer>
        <TextBlock Name="nodatalabel" Margin="0,0,0,50" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#00FFFFFF" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="12" Style="{DynamicResource NoLogInformationForegroundTextBlockStyle}" Text="There is no data to display" Visibility="Collapsed" />
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>