<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.Streaming.FavoriteLocations.FavoriteStreamingLocationsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Style="{DynamicResource FavoriteLocationsUserControlStyle}" xmlns:favoritelocations="clr-namespace:NextAiVPN.UI.Streaming.FavoriteLocations;assembly=NextAiVPN" Visibility="{Binding Path=UserControlVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
  <Control.Template>
    <ControlTemplate TargetType="{x:Type UserControl}">
      <Border Style="{DynamicResource FavoriteBorderTemplateStyle}">
        <ContentPresenter Content="{TemplateBinding ContentControl.Content}" />
      </Border>
    </ControlTemplate>
  </Control.Template>
  <StackPanel ZIndex="999" Orientation="Vertical">
    <ListBox Name="FavoritesList" Margin="0,3,0,10" BorderThickness="0" ItemContainerStyle="{DynamicResource LocationListBoxItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden" Style="{DynamicResource FavoriteStreamingLocationListboxStyle}" ItemsSource="{Binding Locations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <Image Name="flagImage" Width="24" Height="24" Margin="6,3,0,0" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
              <Image.Source>
                <MultiBinding Converter="{StaticResource CountryCityCodesToFlagConverter}" UpdateSourceTrigger="PropertyChanged">
                  <Binding Path="CountryCode" />
                  <Binding Path="CityCode" />
                </MultiBinding>
              </Image.Source>
              <UIElement.RenderTransform>
                <RotateTransform x:Name="TransRotate" Angle="0" CenterX="0" CenterY="0" />
              </UIElement.RenderTransform>
              <FrameworkElement.Resources>
                <ResourceDictionary />
              </FrameworkElement.Resources>
            </Image>
            <TextBlock Name="LocationHeader" Width="210" Margin="15,3,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" FontWeight="Normal" Style="{DynamicResource LocationHeaderDefaultForegroundTextBlockStyle}" Text="{Binding Converter={StaticResource FavoriteStreamingLocationConverter}}">
              <b:Interaction.Triggers>
                <b:EventTrigger EventName="MouseLeftButtonDown">
                  <b:InvokeCommandAction Command="{Binding DataContext.SelectedFavoritesListItemClickedCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}" />
                </b:EventTrigger>
              </b:Interaction.Triggers>
            </TextBlock>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ListBox>
  </StackPanel>
</UserControl>