<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.FeedbackEmojis" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:NextAiVPN" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Style="{DynamicResource FeedbackDefaultBackgroundUserControlStyle}">
  <Grid>
    <Border BorderBrush="#FF000000" BorderThickness="0" Style="{DynamicResource FeedbackBorderBackgroundStyle}">
      <UIElement.Effect>
        <DropShadowEffect BlurRadius="24" Opacity="0.22" Color="Black" />
      </UIElement.Effect>
    </Border>
    <StackPanel Orientation="Vertical">
      <StackPanel Orientation="Horizontal">
        <TextBlock Width="232" Height="24" Margin="12,12,0,0" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" Style="{DynamicResource FeedbackDefaultTextblockHeaderForegroundStyle}" Text="How are we doing?" />
        <Image Name="btnCross" Width="25" Height="25" Margin="0,12,0,12" Style="{DynamicResource XCloseButtonWindowImageStyle}" MouseDown="BtnCross_MouseDown" />
      </StackPanel>
      <TextBlock Name="Description" Width="232" Height="32" Margin="12,0,0,0" HorizontalAlignment="Left" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="12" LineHeight="16" Style="{DynamicResource FeedbackDefaultTextblockForegroundStyle}" Text="Let us know what you think of NextAiVPN" TextWrapping="Wrap" />
      <Grid Width="200" Height="36" Margin="0,12,0,0" HorizontalAlignment="Center">
        <Image Name="mad" Margin="0,0,90,0" HorizontalAlignment="Center" Source="/assets/mad.png" MouseDown="Mad_MouseDown">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Image}">
              <Setter Property="Width" Value="25" />
              <Setter Property="Height" Value="24" />
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Width" Value="32" />
                  <Setter Property="Height" Value="32" />
                  <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Image>
        <Image Name="mah" HorizontalAlignment="Center" Source="/assets/mah.png" MouseDown="Mah_MouseDown">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Image}">
              <Setter Property="Width" Value="25" />
              <Setter Property="Height" Value="24" />
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Width" Value="32" />
                  <Setter Property="Height" Value="32" />
                  <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Image>
        <Image Name="smile" Margin="90,0,0,0" HorizontalAlignment="Center" Source="/assets/smile.png" MouseDown="Smile_MouseDown">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Image}">
              <Setter Property="Width" Value="25" />
              <Setter Property="Height" Value="24" />
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Width" Value="32" />
                  <Setter Property="Height" Value="32" />
                  <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Image>
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>