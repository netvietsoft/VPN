<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.Account.ExpandedAccount" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:account="clr-namespace:NextAiVPN.UI.Account" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
  <Grid>
    <StackPanel Orientation="Vertical">
      <TextBlock Margin="24,20,0,12" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="20" Style="{DynamicResource DefaultTextBlockForegroundStyle}" Text="{Binding Path=MainControlHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <Separator Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Top" Foreground="#FFD3D3D3" Opacity="0.2" />
      <StackPanel Height="Auto" Visibility="Visible">
        <ScrollViewer Height="665" VerticalAlignment="Top" CanContentScroll="True" VerticalScrollBarVisibility="Hidden">
          <StackPanel Margin="24,0,0,0">
            <StackPanel Visibility="{Binding Path=ExpiredMessageVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
              <Border Width="530" Margin="0,20,0,0" HorizontalAlignment="Left" BorderThickness="1" CornerRadius="8" Style="{DynamicResource AccountExpirationMessageBorderStyle}">
                <StackPanel>
                  <StackPanel Margin="10" Orientation="Horizontal">
                    <Image Width="17" Height="17" Margin="10,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" Style="{DynamicResource AccountExpirationMessageImageStyle}" />
                    <TextBlock Style="{DynamicResource AccountExpirationMessageTextBlockStyle}" Text="{Binding Path=ExpiredMessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <Button Width="480" Height="32" Margin="0,12,0,12" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Style="{DynamicResource WhiteButtonStyle}" Command="{Binding ExtendSubscriptionButtonClickCommand}" Content="{Binding Path=ButtonText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- HWID & Device Slots Card (1 PC + 1 Mobile) -->
            <Border Width="500" Margin="0,15,0,0" Padding="14" HorizontalAlignment="Left" Background="{StaticResource BrushBgSubtle}" BorderBrush="{StaticResource BrushBorderEmerald}" BorderThickness="1.5" CornerRadius="10">
              <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushEmerald900}" Text="🔑 Hardware-Bound License (1 PC + 1 Mobile)" />
                  <Border Margin="10,0,0,0" Padding="6,1" Background="{StaticResource BrushEmerald100}" CornerRadius="6">
                    <TextBlock FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushEmerald700}" Text="SLOT ENFORCED" />
                  </Border>
                </StackPanel>
                
                <TextBlock FontSize="11" Foreground="{StaticResource Color6D6E70}" Margin="0,0,0,4" Text="Current PC Hardware ID (HWID Fingerprint):" />
                <Border Padding="8,4" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
                  <TextBlock FontFamily="Consolas, Monospace" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Color2A2A2C}" Text="{Binding Path=MachineHwidText, Mode=OneWay, FallbackValue='HWID-PC-WIN11-8F92-A3B1-94E2'}" />
                </Border>

                <!-- 2 Slots Indicator -->
                <Grid Margin="0,2,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  
                  <Border Grid.Column="0" Margin="0,0,4,0" Padding="8" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorderEmerald}" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                      <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushEmerald700}" Text="🖥️ Slot 1: PC (In Use)" />
                      <TextBlock FontSize="10" Foreground="{StaticResource Color6D6E70}" Text="Bound to this Machine" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Margin="4,0,0,0" Padding="8" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                      <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource Color2A2A2C}" Text="📱 Slot 2: Mobile (Linked)" />
                      <TextBlock FontSize="10" Foreground="{StaticResource Color6D6E70}" Text="iPhone 15 Pro Max (iOS)" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>

            <StackPanel Margin="0,22,0,0">
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" Style="{DynamicResource GeneralExpendedTextBlockStyle}" Text="{Binding Path=UsernameHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <StackPanel Width="500" Margin="0,6,0,0" HorizontalAlignment="Left" Orientation="Horizontal">
                <TextBlock Width="480" FontSize="12" LineHeight="20" Style="{DynamicResource ProtocolInfoTextBlockStyle}" TextWrapping="Wrap" Text="{Binding Path=UsernameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,22,0,0">
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" Style="{DynamicResource GeneralExpendedTextBlockStyle}" Text="{Binding Path=PlanHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <StackPanel Width="500" Margin="0,6,0,0" HorizontalAlignment="Left" Orientation="Vertical">
                <TextBlock Width="480" FontSize="12" LineHeight="20" Style="{DynamicResource ProtocolInfoTextBlockStyle}" TextWrapping="Wrap" Text="{Binding Path=CurrentPlanText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,22,0,0">
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" Style="{DynamicResource GeneralExpendedTextBlockStyle}" Text="{Binding Path=SubscriptionHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <StackPanel Width="500" Margin="0,6,0,0" HorizontalAlignment="Left" Orientation="Vertical">
                <TextBlock Width="480" FontSize="12" LineHeight="20" Style="{DynamicResource ProtocolInfoTextBlockStyle}" TextWrapping="Wrap" Text="{Binding Path=ExpirationDateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,22,0,0">
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" Style="{DynamicResource GeneralExpendedTextBlockStyle}" Text="{Binding Path=AutoRenewalHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <StackPanel Width="500" Margin="0,6,0,0" HorizontalAlignment="Left" Orientation="Vertical">
                <TextBlock Width="480" FontSize="12" LineHeight="20" Style="{DynamicResource ProtocolInfoTextBlockStyle}" TextWrapping="Wrap" Text="{Binding Path=AutoRenewalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,22,0,0" Visibility="{Binding Path=RenewSubscriptionTextVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
              <TextBlock HorizontalAlignment="Left" FontSize="12" LineHeight="20" Style="{DynamicResource LinksTextBlockStyle}" TextWrapping="Wrap" Text="{Binding Path=RenewSubscriptionText}">
                <b:Interaction.Triggers>
                  <b:EventTrigger EventName="MouseDown">
                    <b:InvokeCommandAction Command="{Binding ExtendSubscriptionButtonClickCommand}" />
                  </b:EventTrigger>
                </b:Interaction.Triggers>
              </TextBlock>
              <StackPanel Margin="0,4,0,0" HorizontalAlignment="Left" Orientation="Vertical">
                <TextBlock FontSize="12" LineHeight="20" Style="{DynamicResource ProtocolInfoTextBlockStyle}" TextWrapping="Wrap" Text="{Binding Path=AutoRenewalMessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,22,0,0">
              <TextBlock FontSize="12" Style="{DynamicResource LinksTextBlockStyle}" Text="Sign Out">
                <b:Interaction.Triggers>
                  <b:EventTrigger EventName="MouseDown">
                    <b:InvokeCommandAction Command="{Binding SignOutMouseDownCommand}" />
                  </b:EventTrigger>
                </b:Interaction.Triggers>
              </TextBlock>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>