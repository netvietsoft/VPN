<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.Favotite.FavoriteLocationListItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:favotite="clr-namespace:NextAiVPN.UI.Favotite;assembly=NextAiVPN" Loaded="FavoriteLocationListItem_OnLoaded">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="50" />
    </Grid.ColumnDefinitions>
    <Border Name="LocationItemHoverBorder" Width="450" Height="40" Margin="-60,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="20" Style="{DynamicResource SelectedLocationBorderStyle}" Cursor="Hand">
      <Grid Name="CountryMainGrid" ColumnSpan="5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40" />
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.Column="0" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" ClipToBounds="True" BorderBrush="#25000000" BorderThickness="1.5">
          <Image Name="CountryFlag" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" Source="{Binding Path=CountryCode, Converter={StaticResource CountryCodeToFlagConverter}}" />
        </Border>
        <Grid Row="0" Column="1">
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Name="CountryName" VerticalAlignment="Center" Style="{DynamicResource LocationListBoxItemsTextForegroundTextBlockStyle}" Text="{Binding Country}" />
          <TextBlock Name="CityName" Grid.Row="1" VerticalAlignment="Center" Style="{DynamicResource LocationCityListBoxItemsTextForegroundTextBlockStyle}" Text="{Binding City}" />
        </Grid>
        <TextBlock Name="Ping" Grid.Row="0" Grid.Column="2" Margin="-15,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource LocationListBoxItemsTextForegroundTextBlockStyle}" Text="{Binding PingMs, Converter={StaticResource AllLocationsPingConverter}}" />
      </Grid>
    </Border>
    <Grid Row="0" Column="1" Margin="-30,0,0,0">
      <Ellipse Name="ExpanderHover" Width="37" Height="37" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#00FFFFFF" MouseDown="ExpanderHover_OnMouseDown" PreviewMouseLeftButtonDown="ExpanderHover_OnPreviewMouseLeftButtonDown" MouseEnter="ExpanderHover_OnMouseEnter" MouseLeave="ExpanderHover_OnMouseLeave" />
      <Image Name="RemoveFavoriteLocation" Width="20" Height="20" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" Style="{DynamicResource DeleteTrustedNetworkImageStyle}" MouseDown="RemoveFavoriteLocation_OnMouseDown" PreviewMouseLeftButtonDown="RemoveFavoriteLocation_OnPreviewMouseLeftButtonDown" MouseEnter="ExpanderHover_OnMouseEnter" />
    </Grid>
  </Grid>
</UserControl>