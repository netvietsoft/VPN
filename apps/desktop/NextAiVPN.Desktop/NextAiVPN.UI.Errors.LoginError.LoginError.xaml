<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.Errors.LoginError.LoginError" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Style="{DynamicResource {x:Type UserControl}}" xmlns:loginerror="clr-namespace:NextAiVPN.UI.Errors.LoginError;assembly=NextAiVPN">
  <Grid Name="ConnectedGrid" Style="{DynamicResource MainPanelGridBackgroundStyle}">
    <Image Name="TopImage" Grid.Row="0" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Source="/Assets/vpn-background.png" Stretch="None" />
    <Grid Margin="0">
      <Image Width="40" Height="40" Margin="0,-245,0,0" Source="/Assets/WarningTriangle.png" />
      <TextBlock Height="32" Margin="110,-160,0,0" FontFamily="{DynamicResource MuseoSans600FontFamily}" FontSize="26" Foreground="#FFF0F8FF" Text="An error occured" />
      <Grid Margin="60,280,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="30" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Image Grid.Row="0" Grid.Column="0" Width="20" Height="20" VerticalAlignment="Top" Source="/Assets/1.png" />
        <TextBlock Grid.Row="0" Grid.Column="1" Width="220" Margin="-90,0,0,0" FontFamily="{DynamicResource MuseoSans400FontFamily}" FontSize="14" Foreground="#FFF0F8FF" Text="Your VPN might have been blocked by your Internet provider. Please try again by selecting a different network and restart the app." TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Grid.Column="2" Width="220" Margin="-90,0,0,0" FontFamily="{DynamicResource MuseoSans400FontFamily}" FontSize="14" Foreground="#FFF0F8FF" Text="or" TextAlignment="Center" />
        <Image Grid.Row="2" Grid.Column="0" Width="20" Height="20" VerticalAlignment="Top" Source="/Assets/2.png" />
        <TextBlock Grid.Row="2" Grid.Column="2" Width="220" Margin="-90,0,0,0" FontFamily="{DynamicResource MuseoSans400FontFamily}" FontSize="14" Foreground="#FFF0F8FF" Text="Please let us know what the problem is " TextWrapping="Wrap" />
        <TextBlock Grid.Row="2" Grid.Column="1" Margin="76,17,-43,10" FontFamily="{DynamicResource MuseoSans400FontFamily}" FontSize="14" Foreground="#FFF0F8FF" Style="{DynamicResource LinkWhiteTextBlockStyle}" Text="here." TextWrapping="Wrap">
          <b:Interaction.Triggers>
            <b:EventTrigger EventName="MouseDown">
              <b:InvokeCommandAction Command="{Binding LinkClickCommand}" />
            </b:EventTrigger>
          </b:Interaction.Triggers>
        </TextBlock>
      </Grid>
    </Grid>
  </Grid>
</UserControl>