<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NextAiVPN.UI.SplitTunneling.SplitTunnelingDomainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:entities="clr-namespace:NextAiVPN.Entities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="SplitTunnelingDomainWindow" Width="360" ResizeMode="NoResize" Style="{DynamicResource DeleteLogsMessageWindowBackgroundStyle}" WindowStartupLocation="CenterScreen" xmlns:splittunneling="clr-namespace:NextAiVPN.UI.SplitTunneling" Height="{Binding WindowHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ParentWindowVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
  <UIElement.InputBindings>
    <KeyBinding Key="Enter" Command="{Binding EnterKeyPressedCommand}" />
  </UIElement.InputBindings>
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" />
  </WindowChrome.WindowChrome>
  <Grid Margin="30">
    <Grid.RowDefinitions>
      <RowDefinition Height="50" MaxHeight="50" />
      <RowDefinition Height="70" />
      <RowDefinition Height="*" />
      <RowDefinition Height="50" MaxHeight="50" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" Style="{DynamicResource GeneralExpendedTextBlockStyle}" Text="{Binding Title}" />
      <TextBlock Margin="0,6,0,0" HorizontalAlignment="Left" FontSize="12" LineHeight="19" Style="{DynamicResource ProtocolInfoTextBlockStyle}" TextWrapping="Wrap" Text="{Binding Description}" />
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Vertical">
      <Grid>
        <Border Height="32" Margin="0,4,0,4" BorderThickness="1" Style="{DynamicResource SplitTunnelingDomainAddBorderStyle}" BorderBrush="{Binding DomainTextBoxBorderBrush, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <TextBox Name="DomainTextBox" Width="263" Height="32" HorizontalAlignment="Left" VerticalContentAlignment="Center" AcceptsReturn="False" BorderThickness="0" Focusable="True" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="14" Style="{DynamicResource SplitTunnelingDomainAddTextBoxStyle}" TextAlignment="Left" Text="{Binding Path=AddDomainText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <b:Interaction.Triggers>
              <b:EventTrigger EventName="LostFocus">
                <b:InvokeCommandAction Command="{Binding DomainTextBoxLostFocusCommand}" />
              </b:EventTrigger>
              <b:EventTrigger EventName="GotFocus">
                <b:InvokeCommandAction Command="{Binding DomainTextBoxGotFocusCommand}" />
              </b:EventTrigger>
            </b:Interaction.Triggers>
          </TextBox>
        </Border>
        <TextBlock Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource LinksTextBlockStyle}" Text="Add" Visibility="{Binding AddItemVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <b:Interaction.Triggers>
            <b:EventTrigger EventName="MouseLeftButtonDown">
              <b:InvokeCommandAction Command="{Binding AddItemClickCommand}" />
            </b:EventTrigger>
          </b:Interaction.Triggers>
        </TextBlock>
        <TextBlock Margin="0,0,0,-13" VerticalAlignment="Bottom" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="12" Foreground="#FFFF0000" Text="{Binding ErrorMessage}" Visibility="{Binding DomainErrorTextVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      </Grid>
      <StackPanel Orientation="Horizontal">
        <CheckBox Margin="0,13,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="{DynamicResource Color6F7072}" Content="Include all subdomains" Style="{DynamicResource CheckBoxStyle}" IsChecked="{Binding Path=IsSubdomainsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Image Width="13.33" Height="13.33" Margin="5,10,0,0" Style="{DynamicResource SplitTunnelingIncludeSubDomainsInfoImageStyle}">
          <FrameworkElement.ToolTip>
            <ToolTip HorizontalOffset="-121" Style="{DynamicResource SplitTunnelingIncludeSubDomainsToolTipStyle}" VerticalOffset="-121" />
          </FrameworkElement.ToolTip>
        </Image>
      </StackPanel>
    </StackPanel>
    <Grid Row="2" Margin="0,10,0,0" Visibility="{Binding DomainListVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
      <StackPanel Orientation="Vertical">
        <Separator Width="Auto" />
        <ScrollViewer Name="ScrollViewer" IsEnabled="True" HorizontalScrollBarVisibility="Hidden" Height="{Binding ScrollHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <ListBox Width="Auto" Height="Auto" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden" Style="{DynamicResource SplitTunnelingListboxBackgroundStyle}" ItemsSource="{Binding DomainList}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type entities:SplitTunnelingDomain}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="258" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Image Width="13.3" Height="13.3" HorizontalAlignment="Left" Style="{DynamicResource SplitTunnelingDomainsCheckImageStyle}" />
                  <TextBlock Grid.Column="1" Margin="3,2,0,0" HorizontalAlignment="Left" FontSize="14" Style="{DynamicResource TrustedNetworkTextBlockStyle}" TextAlignment="Justify" TextTrimming="CharacterEllipsis" Width="{Binding DataContext.TextBoxItemWidth, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Text="{Binding Name, Mode=OneWay}">
                    <FrameworkElement.ToolTip>
                      <ToolTip Style="{DynamicResource SplitTunnelingListItemToolTipStyle}" ToolTip="{Binding ToolTip, Mode=OneWay}" />
                    </FrameworkElement.ToolTip>
                    <UIElement.InputBindings>
                      <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.DomainsItemDoubleClickPressedCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}" />
                    </UIElement.InputBindings>
                  </TextBlock>
                  <Image Name="RemoveApp" Grid.Column="2" Style="{DynamicResource DeleteTrustedNetworkImageStyle}" Margin="{Binding DataContext.RemoveImageItemMargin, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}">
                    <b:Interaction.Triggers>
                      <b:EventTrigger EventName="MouseLeftButtonDown">
                        <b:InvokeCommandAction Command="{Binding DataContext.RemoveItemClickCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}" />
                      </b:EventTrigger>
                    </b:Interaction.Triggers>
                  </Image>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </StackPanel>
    </Grid>
    <Grid Row="3" Margin="0,5,0,0">
      <Button Width="68" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom" Content="Done" Style="{DynamicResource OkButtonBindingTextStyle}" Command="{Binding DoneButtonClickCommand}" />
    </Grid>
  </Grid>
</Window>