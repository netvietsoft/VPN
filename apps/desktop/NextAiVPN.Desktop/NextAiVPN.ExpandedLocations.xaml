<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.ExpandedLocations" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:allLocations="clr-namespace:NextAiVPN.UI.AllLocations" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:favotite="clr-namespace:NextAiVPN.UI.Favotite" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:streamingLoc="clr-namespace:NextAiVPN.UI.Streaming.Locations" 
             Focusable="True" 
             FontFamily="{DynamicResource MuseoSans500FontFamily}"
             FontSize="12"
             Foreground="{DynamicResource Color2E2E33}"
             Background="{DynamicResource BrushBgSubtle}">
  <Grid Name="MainGrid">
    <Rectangle Name="DisablerRectangle" Grid.ColumnSpan="2" Panel.ZIndex="990" Fill="#00FFFFFF" IsEnabled="False" Opacity="0.4" Visibility="Collapsed" IsHitTestVisible="False" />
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
      <StackPanel Orientation="Vertical" MaxWidth="820" HorizontalAlignment="Left">
        
        <!-- HEADER ROW WITH TITLE & SEARCH -->
        <Border Background="#FFFFFF" BorderBrush="{DynamicResource BrushBorderEmerald}" BorderThickness="1.5" CornerRadius="12" Padding="18" Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Name="LocationsTitle" Text="🌍 Server Locations (42 Worldwide Nodes)" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald900}" />
                <Border Margin="10,0,0,0" Padding="6,2" Background="{DynamicResource BrushEmerald100}" CornerRadius="6" VerticalAlignment="Center">
                  <TextBlock Text="LOWEST PING FIRST" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald700}" />
                </Border>
              </StackPanel>
              <TextBlock Text="Select from dedicated high-speed SOCKS5, HTTP, and WireGuard residential endpoints." FontSize="12" Foreground="{DynamicResource Color6D6E70}" />
            </StackPanel>

            <!-- Server counter badge -->
            <Border Grid.Column="1" Background="{DynamicResource BrushEmerald50}" BorderBrush="{DynamicResource BrushBorderEmerald}" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
              <TextBlock Text="42 Online" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald700}" />
            </Border>
          </Grid>
        </Border>

        <!-- FILTER CHIPS & TABS ROW -->
        <Border Background="#FFFFFF" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,14">
          <StackPanel Orientation="Vertical">
            <!-- Legacy Named Controls for SDK Compatibility -->
            <StackPanel Name="VpnModesPanel" Orientation="Horizontal">
              <Border Name="PrivateModeBorder" Padding="12,6" Margin="0,0,8,0" Background="{DynamicResource BrushEmerald600}" CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="PrivateModeBorder_OnMouseLeftButtonDown" PreviewMouseLeftButtonDown="PrivateModeBorder_OnMouseLeftButtonDown">
                <TextBlock Name="PrivateModeTextBlock" Text="All Locations (42)" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
              </Border>

              <StackPanel Name="StreamingModeStackPanel" Orientation="Horizontal">
                <Border Name="StreamingModeBorder" Padding="12,6" Margin="0,0,8,0" Background="{DynamicResource BrushBgSubtle}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="StreamingModeBorder_OnMouseLeftButtonDown">
                  <TextBlock Name="StreamingModeTextBlock" Text="⚡ For Streaming" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" VerticalAlignment="Center" />
                </Border>
                <Border Name="StreamingInfoItem" Width="32" Height="14" Margin="5,-15,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="8" Style="{DynamicResource BetaInfoBorderStyle}" Visibility="Collapsed" MouseLeftButtonDown="StreamingInfo_OnMouseLeftButtonDown">
                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource BetaInfoTextBlockStyle}" Text="BETA" />
                </Border>
              </StackPanel>

              <Border Name="FavoriteLocationsBorder" Padding="12,6" Margin="0,0,8,0" Background="{DynamicResource BrushBgSubtle}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="FavoriteLocations_OnMouseLeftButtonDown" PreviewMouseLeftButtonDown="FavoriteLocations_OnMouseLeftButtonDown">
                <TextBlock Name="FavoriteLocationsTextBlock" Text="⭐ Favorites" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
            <Separator Name="VpnModesBottomSeparator" Visibility="Collapsed" />
          </StackPanel>
        </Border>

        <!-- LOCATIONS CONTENT CONTAINER -->
        <Border Background="#FFFFFF" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,16">
          <Grid>
            <!-- View 1: Streaming Locations -->
            <streamingLoc:StreamingLocations x:Name="StreamingLocations" Visibility="Collapsed" />

            <!-- View 2: Favorite Locations -->
            <Grid Name="FavoriteLocationsTabGrid" Visibility="Collapsed">
              <favotite:FavoriteLocationsTab x:Name="FavoriteLocationsTabControl" />
            </Grid>

            <!-- View 3: All Locations List -->
            <Grid Name="AllLocationsGrid">
              <allLocations:AllLocationsControl x:Name="AllLocationsControl" MinHeight="420" />
            </Grid>

            <!-- Loading Indicator -->
            <StackPanel Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock Width="170" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="14" Foreground="{StaticResource Color787879}" Text="Loading locations..." TextAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>