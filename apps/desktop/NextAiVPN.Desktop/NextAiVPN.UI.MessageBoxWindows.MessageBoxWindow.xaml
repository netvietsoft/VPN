<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NextAiVPN.UI.MessageBoxWindows.MessageBoxWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:messageBoxWindows="clr-namespace:NextAiVPN.UI.MessageBoxWindows" Width="350" Height="160" ResizeMode="NoResize" Style="{DynamicResource DeleteLogsMessageWindowBackgroundStyle}" WindowStartupLocation="CenterScreen" WindowStyle="None">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" />
  </WindowChrome.WindowChrome>
  <Grid>
    <Border BorderBrush="{DynamicResource Color2A2A2C}" BorderThickness="0.3">
      <StackPanel>
        <Grid>
          <TextBlock Width="Auto" Height="24" Margin="24,25,0,0" HorizontalAlignment="Left" FontSize="20" Style="{DynamicResource DeleteLogsMessageWindowTextBlockHeaderForegroundStyle}" Text="{Binding Header, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
          <Image Width="25" Height="25" Margin="0,0,10,0" HorizontalAlignment="Right" Style="{DynamicResource XCloseButtonWindowImageStyle}">
            <b:Interaction.Triggers>
              <b:EventTrigger EventName="MouseDown">
                <b:InvokeCommandAction Command="{Binding CloseClickCommand}" CommandParameter="{Binding ElementName=TrustedNetworkControl}" />
              </b:EventTrigger>
            </b:Interaction.Triggers>
          </Image>
        </Grid>
        <TextBlock Width="300" Height="Auto" Margin="24,7,0,0" HorizontalAlignment="Left" FontSize="12" Style="{DynamicResource DeleteLogsMessageWindowTextBlockForegroundStyle}" TextWrapping="Wrap" Text="{Binding Description, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
        <StackPanel Margin="16,25,16,0" HorizontalAlignment="Center" Background="#00FFFFFF" Orientation="Horizontal">
          <Button Width="134" Height="32" Style="{DynamicResource CancelButtonBindingTextStyle}" Command="{Binding CancelClickCommand}" Content="{Binding CancelButtonText}" Visibility="{Binding CancelButtonVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <Button Width="134" Height="32" Margin="2,0,0,0" Style="{DynamicResource OkButtonBindingTextStyle}" Command="{Binding OkClickCommand}" Content="{Binding OkButtonText}" Visibility="{Binding OkButtonVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>