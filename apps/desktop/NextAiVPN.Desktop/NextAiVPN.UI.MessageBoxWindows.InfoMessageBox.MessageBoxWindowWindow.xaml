<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NextAiVPN.UI.MessageBoxWindows.InfoMessageBox.MessageBoxWindowWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="Window" Title="DeviceLimitWindow" ResizeMode="NoResize" SizeToContent="Height" Style="{DynamicResource DeleteLogsMessageWindowBackgroundStyle}" WindowStartupLocation="CenterScreen" WindowStyle="None" xmlns:infomessagebox="clr-namespace:NextAiVPN.UI.MessageBoxWindows.InfoMessageBox;assembly=NextAiVPN" Loaded="MessageBoxWindowWindow_OnLoaded">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" />
  </WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0" Margin="16,16,0,0">
      <TextBlock Name="TextBlockTitle" HorizontalAlignment="Left" FontSize="20" Style="{DynamicResource DeleteLogsMessageWindowTextBlockHeaderForegroundStyle}" TextWrapping="Wrap" />
      <Image Width="25" Height="25" Margin="0,0,16,0" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{DynamicResource XCloseButtonWindowImageStyle}" MouseDown="XCloseImage_OnMouseDown" />
    </Grid>
    <TextBlock Name="SubTitle" Grid.Row="1" Width="279" Height="Auto" Margin="16,6,0,16" HorizontalAlignment="Left" FontSize="14" Style="{DynamicResource DeleteLogsMessageWindowTextBlockForegroundStyle}" TextWrapping="Wrap" />
    <Button Grid.Row="3" Height="32" Margin="16,0,16,16" Content="I understand" Style="{DynamicResource OkButtonBindingTextStyle}" Click="IUnderstand_OnMouseDown" />
  </Grid>
</Window>