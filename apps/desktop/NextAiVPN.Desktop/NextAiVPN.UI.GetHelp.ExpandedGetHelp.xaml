<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.GetHelp.ExpandedGetHelp" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Style="{DynamicResource {x:Type UserControl}}" xmlns:gethelp="clr-namespace:NextAiVPN.UI.GetHelp;assembly=NextAiVPN">
  <Grid Background="{DynamicResource White}">
    <StackPanel Orientation="Vertical">
      <TextBlock Margin="24,20,0,12" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" Text="{Binding Path=MainControlHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <Separator Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Top" Foreground="#E2E8F0" Opacity="0.6" />
      <StackPanel Height="Auto">
        <ScrollViewer Height="665" VerticalAlignment="Top" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,0,24,0">
            
            <!-- Send Feedback Section -->
            <StackPanel Margin="0,24,0,0">
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" Text="{Binding SendFeedbackHeader}" />
              <TextBlock Margin="0,6,0,0" Width="480" HorizontalAlignment="Left" FontSize="13" LineHeight="20" Foreground="{DynamicResource Color6D6E70}" TextWrapping="Wrap" Text="{Binding SendFeedbackText}" />
              <TextBlock Margin="0,6,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushEmerald700}" Cursor="Hand" TextDecorations="Underline" Text="{Binding SendFeedbackLinkText}">
                <b:Interaction.Triggers>
                  <b:EventTrigger EventName="MouseDown">
                    <b:InvokeCommandAction Command="{Binding SendFeedbackMouseDownCommand}" />
                  </b:EventTrigger>
                </b:Interaction.Triggers>
              </TextBlock>
            </StackPanel>

            <!-- FAQ Section -->
            <StackPanel Margin="0,24,0,0">
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" Text="{Binding FAQHeader}" />
              <TextBlock Margin="0,6,0,0" Width="480" HorizontalAlignment="Left" FontSize="13" LineHeight="20" Foreground="{DynamicResource Color6D6E70}" TextWrapping="Wrap" Text="{Binding FAQText}" />
              <TextBlock Margin="0,6,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushEmerald700}" Cursor="Hand" TextDecorations="Underline" Text="{Binding FAQLinkText}">
                <b:Interaction.Triggers>
                  <b:EventTrigger EventName="MouseDown">
                    <b:InvokeCommandAction Command="{Binding FAQMouseDownCommand}" />
                  </b:EventTrigger>
                </b:Interaction.Triggers>
              </TextBlock>
            </StackPanel>

            <!-- Customer Support Section -->
            <StackPanel Margin="0,24,0,0">
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" Text="{Binding CustomerSupportHeader}" />
              <TextBlock Margin="0,6,0,0" Width="480" HorizontalAlignment="Left" FontSize="13" LineHeight="20" Foreground="{DynamicResource Color6D6E70}" TextWrapping="Wrap" Text="{Binding CustomerSupportText}" />
              <TextBlock Margin="0,6,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushEmerald700}" Cursor="Hand" TextDecorations="Underline" Text="{Binding CustomerSupportLinkText}">
                <b:Interaction.Triggers>
                  <b:EventTrigger EventName="MouseDown">
                    <b:InvokeCommandAction Command="{Binding CustomerSupportMouseDownCommand}" />
                  </b:EventTrigger>
                </b:Interaction.Triggers>
              </TextBlock>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>