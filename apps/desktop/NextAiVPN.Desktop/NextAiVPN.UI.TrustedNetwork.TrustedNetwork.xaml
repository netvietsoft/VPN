<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.TrustedNetwork.TrustedNetwork" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="TrustedNetworkControl" xmlns:trustednetwork="clr-namespace:NextAiVPN.UI.TrustedNetwork;assembly=NextAiVPN">
  <Border Name="MainBorder" Height="24" Style="{DynamicResource TrustedNetworkBorderStyle}">
    <StackPanel Orientation="Horizontal">
      <Image Name="WiFiIcon" Width="12" Height="12" Margin="10,0,0,0" Style="{DynamicResource WiFiLogoImageStyle}" Source="{Binding WiFiLogoImageSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Name="NetworkName" Margin="10,3,0,0" Style="{DynamicResource ProtocolInfoTextBlockStyle}" Text="{Binding NetworkName, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
      <Image Name="RemoveTrustedNetwork" Width="10" Height="10" Margin="5,0,5,0" Style="{DynamicResource XCloseGrayButtonStyle}" Source="{Binding CloseButtonImageSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
        <b:Interaction.Triggers>
          <b:EventTrigger EventName="MouseDown">
            <b:InvokeCommandAction Command="{Binding RemoveTrustedNetworkClickCommand}" CommandParameter="{Binding ElementName=TrustedNetworkControl}" />
          </b:EventTrigger>
        </b:Interaction.Triggers>
      </Image>
    </StackPanel>
  </Border>
</UserControl>