<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.ExpandedMainPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NextAiVPN"
             xmlns:errors="clr-namespace:NextAiVPN.UI.Errors.ConnectionError"
             xmlns:disclaimer="clr-namespace:NextAiVPN.UI.MainPanelPopUps.IpAddressRotationDisclaimer"
             xmlns:trial="clr-namespace:NextAiVPN.UI.Trial"
             xmlns:connectionData="clr-namespace:NextAiVPN.UI.MainPanelConnectionData"
             xmlns:accountPopUp="clr-namespace:NextAiVPN.UI.Account.PopUp"
             xmlns:favorite="clr-namespace:NextAiVPN.UI.Favotite"
             xmlns:streamingFavorite="clr-namespace:NextAiVPN.UI.Streaming.FavoriteLocations"
             xmlns:feedbackPopUp="clr-namespace:NextAiVPN.UI.Feedback.PopUp"
             xmlns:splitTunnelingPopUp="clr-namespace:NextAiVPN.UI.SplitTunneling.PopUp"
             xmlns:mainPanelNotification="clr-namespace:NextAiVPN.UI.MainPanelNotification"
             mc:Ignorable="d"
              Background="{DynamicResource BrushBgSubtle}"
              Loaded="UserControl_Loaded">
  <UserControl.Resources>
    <!-- Custom Clean Emerald Toggle Switch Style -->
    <Style x:Key="EmeraldToggleSwitchStyle" TargetType="{x:Type CheckBox}">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type CheckBox}">
            <Border x:Name="ToggleTrack" Width="36" Height="20" CornerRadius="10" Background="#CBD5E1" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Ellipse x:Name="ToggleThumb" Width="14" Height="14" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0">
                <Ellipse.Effect>
                  <DropShadowEffect Color="#000000" Opacity="0.15" ShadowDepth="1" BlurRadius="2" />
                </Ellipse.Effect>
              </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ToggleTrack" Property="Background" Value="#059669" />
                <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="ToggleThumb" Property="Margin" Value="0,0,3,0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <!-- VISIBLE MODERN CLEAN EMERALD 2-COLUMN DASHBOARD -->
    <Grid Margin="16,14,16,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="310" />
      </Grid.ColumnDefinitions>

      <!-- LEFT COLUMN: MAIN CONNECT CARD -->
      <Border Grid.Column="0" Margin="0,0,14,0" Background="{DynamicResource White}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="20">
        <Border.Effect>
          <DropShadowEffect Color="#0F172A" Opacity="0.05" ShadowDepth="4" BlurRadius="14" />
        </Border.Effect>
        <DockPanel LastChildFill="True">
          <!-- Top: Selected Server Header -->
          <Border DockPanel.Dock="Top" Padding="0,0,0,14" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
              <!-- Change Server Button -->
              <Button Name="ChangeServerBtn" DockPanel.Dock="Right" Padding="12,6" Background="{DynamicResource BrushEmerald50}" BorderBrush="{DynamicResource BrushBorderEmerald}" BorderThickness="1" Foreground="{DynamicResource BrushEmerald700}" FontWeight="Bold" FontSize="12" Cursor="Hand" VerticalAlignment="Center" Click="ChangeServerBtn_Click">
                <Button.Template>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                      <TextBlock Text="Change Server" Foreground="{TemplateBinding Foreground}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>

              <!-- Server Info & Flag -->
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="16" ClipToBounds="True" BorderBrush="#20000000" BorderThickness="1.5" Margin="0,0,10,0">
                  <Image Name="locationImage" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" Source="/Resources/Flags/vn.png" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Name="Location" Text="{Binding LocationName, FallbackValue='Vietnam', TargetNullValue='Vietnam'}" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" />
                  <TextBlock Name="City" Text="{Binding CityName, FallbackValue='Hanoi (VNPT Residential 1Gbps)', TargetNullValue='Hanoi (VNPT Residential 1Gbps)'}" FontSize="11" Foreground="{DynamicResource Color6D6E70}" />
                </StackPanel>
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Bottom: Live Bandwidth Metrics Grid -->
          <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Download Card -->
            <Border Grid.Column="0" Margin="0,0,6,0" Padding="12,10" Background="{DynamicResource BrushBgSubtle}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10">
              <DockPanel>
                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource BrushEmerald100}" Margin="0,0,10,0" VerticalAlignment="Center">
                  <Path Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource BrushEmerald700}" Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z" Stretch="Uniform" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="DOWNLOAD" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Color6D6E70}" />
                  <TextBlock Name="DownloadUsageText" Text="{Binding networkUsageDownloadMB, FallbackValue='184.5 MB', TargetNullValue='184.5 MB'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" />
                  <TextBlock Name="DownloadSpeedText" Text="45.2 MB/s" FontSize="10" Foreground="{DynamicResource BrushEmerald600}" />
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- Upload Card -->
            <Border Grid.Column="1" Margin="6,0,0,0" Padding="12,10" Background="{DynamicResource BrushBgSubtle}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10">
              <DockPanel>
                <Border Width="34" Height="34" CornerRadius="8" Background="#E0F2FE" Margin="0,0,10,0" VerticalAlignment="Center">
                  <Path Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#0284C7" Data="M5,20H19V18H5M5,10H9V16H15V10H19L12,3L5,10Z" Stretch="Uniform" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="UPLOAD" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Color6D6E70}" />
                  <TextBlock Name="UploadUsageText" Text="{Binding networkUsageUploadMB, FallbackValue='92.4 MB', TargetNullValue='92.4 MB'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Color2A2A2C}" />
                  <TextBlock Name="UploadSpeedText" Text="12.4 MB/s" FontSize="10" Foreground="#0284C7" />
                </StackPanel>
              </DockPanel>
            </Border>
          </Grid>

          <!-- Center: Big Power Orb Button Area -->
          <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <!-- Outer Ring (140x140) -->
              <Border Name="PowerBtnRing" Width="140" Height="140" CornerRadius="70" Background="{DynamicResource White}" BorderBrush="{DynamicResource BrushEmerald100}" BorderThickness="8" Cursor="Hand" MouseLeftButtonDown="Connect_PreviewMouseLeftButtonDown">
                <Border.Effect>
                  <DropShadowEffect Color="#059669" Opacity="0.2" ShadowDepth="6" BlurRadius="20" />
                </Border.Effect>
                <!-- Inner Orb (96x96) -->
                <Border Name="PowerBtnInner" Width="96" Height="96" CornerRadius="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#059669" Offset="0" />
                      <GradientStop Color="#064E3B" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <Path Name="PowerIconPath" Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource White}" Data="M16.56,5.44L15.11,6.89C16.84,8.63 17.89,11.02 17.89,13.67C17.89,18.82 13.71,23 8.56,23C3.41,23 -0.78,18.82 -0.78,13.67C-0.78,11.02 0.27,8.63 2,6.89L0.56,5.44C-1.57,7.57 -2.89,10.47 -2.89,13.67C-2.89,19.97 2.25,25.11 8.56,25.11C14.86,25.11 20,19.97 20,13.67C20,10.47 18.68,7.57 16.56,5.44M7.44,1V13.67H9.67V1H7.44Z" Stretch="Uniform" />
                </Border>
              </Border>

              <!-- Status Label & Duration Timer -->
              <TextBlock Name="vpnConnectedText" Text="CONNECTED" Margin="0,14,0,4" HorizontalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" FontWeight="ExtraBold" Foreground="{DynamicResource BrushEmerald800}" />
              <TextBlock Name="vpnTimeValue" Text="{Binding TimeElapsed, StringFormat={}{0:hh\:mm\:ss}, FallbackValue='01:24:18', TargetNullValue='01:24:18'}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Color6D6E70}" />
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>

      <!-- RIGHT COLUMN: TELEMETRY & QUICK TOGGLES (310px) -->
      <StackPanel Grid.Column="1" Orientation="Vertical">
        <!-- 1. Connection Telemetry Card -->
        <Border Background="{DynamicResource White}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12">
          <Border.Effect>
            <DropShadowEffect Color="#0F172A" Opacity="0.04" ShadowDepth="2" BlurRadius="10" />
          </Border.Effect>
          <StackPanel>
            <TextBlock Text="CONNECTION TELEMETRY" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Color959596}" Margin="0,0,0,10" />

            <!-- Protected IP Box -->
            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Padding="8,3" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" Cursor="Hand" VerticalAlignment="Center">
                  <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="📋 Copy" Foreground="{TemplateBinding Foreground}" FontWeight="Bold" FontSize="10" />
                      </Border>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="PROTECTED IP ADDRESS" FontSize="9" FontWeight="Bold" Foreground="#065F46" />
                  <TextBlock Name="IpAddressText" Text="{Binding IpAddress, FallbackValue='192.111.130.5', TargetNullValue='192.111.130.5'}" FontSize="13" FontWeight="Bold" Foreground="#064E3B" FontFamily="{DynamicResource MuseoSans700FontFamily}" />
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- Gateway Protocol -->
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="Gateway Port" FontSize="11" Foreground="{DynamicResource Color6D6E70}" />
              <TextBlock Text="10000 (Universal SOCKS5/HTTP)" TextAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald700}" />
            </DockPanel>

            <!-- Kill Switch Status -->
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="Kill Switch" FontSize="11" Foreground="{DynamicResource Color6D6E70}" />
              <TextBlock Text="🟢 Active (WFP Filter)" TextAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald600}" />
            </DockPanel>

            <!-- DNS Leak -->
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="DNS Leak" FontSize="11" Foreground="{DynamicResource Color6D6E70}" />
              <TextBlock Text="🟢 Secured (Encrypted)" TextAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald600}" />
            </DockPanel>

            <!-- Mesh Status -->
            <DockPanel>
              <TextBlock Text="Mesh Hub" FontSize="11" Foreground="{DynamicResource Color6D6E70}" />
              <TextBlock Text="🟢 3 Nodes Online" TextAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald600}" />
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- 2. Quick Switches Card -->
        <Border Background="{DynamicResource White}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="16">
          <Border.Effect>
            <DropShadowEffect Color="#0F172A" Opacity="0.04" ShadowDepth="2" BlurRadius="10" />
          </Border.Effect>
          <StackPanel>
            <TextBlock Text="QUICK SWITCHES" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Color959596}" Margin="0,0,0,10" />

            <!-- Auto-Connect Switch -->
            <DockPanel Margin="0,0,0,10">
              <TextBlock Text="Auto-Connect on Startup" FontSize="11" Foreground="{DynamicResource Color2A2A2C}" VerticalAlignment="Center" />
              <CheckBox IsChecked="True" Style="{StaticResource EmeraldToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Kill Switch -->
            <DockPanel Margin="0,0,0,10">
              <TextBlock Text="WFP Kill Switch" FontSize="11" Foreground="{DynamicResource Color2A2A2C}" VerticalAlignment="Center" />
              <CheckBox IsChecked="True" Style="{StaticResource EmeraldToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Split Tunneling -->
            <DockPanel Margin="0,0,0,10">
              <TextBlock Text="Split Tunneling" FontSize="11" Foreground="{DynamicResource Color2A2A2C}" VerticalAlignment="Center" />
              <CheckBox IsChecked="False" Style="{StaticResource EmeraldToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Residential Routing -->
            <DockPanel>
              <TextBlock Text="Residential Mesh Node" FontSize="11" Foreground="{DynamicResource Color2A2A2C}" VerticalAlignment="Center" />
              <CheckBox IsChecked="True" Style="{StaticResource EmeraldToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- HIDDEN COMPATIBILITY CONTROLS CONTAINER (Required for complete SDK, ViewModels and Popups binding) -->
    <Grid x:Name="HiddenCompatibilityGrid" Visibility="Collapsed">
      <Button Name="Connect" Content="{Binding StatusButton}" Visibility="Collapsed" IsEnabled="{Binding ButtonEnable}" />
      <StackPanel Name="ConnectBtnPanel" Visibility="Collapsed" />
      <Grid Name="ConnectButtonPanel" Visibility="Collapsed" />
      <Grid Name="ConnectedGrid" Visibility="Collapsed" />
      <Grid Name="BackgroundImageGrid" Visibility="Collapsed" />
      <Rectangle Name="RectangleSeparator" Visibility="Collapsed" />
      <Rectangle Name="DisablerRectangle" Visibility="Collapsed" />
      <Border Name="ExpandCollapse" Visibility="Collapsed" />
      <Image Name="TopImage" Visibility="Collapsed" />
      <Image Name="spinner" Visibility="Collapsed" />
      <Image Name="loadingspinner" Visibility="Collapsed" />
      <TextBlock Name="NetworkType" Visibility="Collapsed" />
      <Image Name="NetworkTypeImage" Visibility="Collapsed" />
      <TextBlock Name="NetworkDescription" Visibility="Collapsed" />
      <TextBlock Name="blinkingConnection" Visibility="Collapsed" />
      <TextBlock Name="ReconnectingBlink" Visibility="Collapsed" />
      <Image Name="ImageReconnecting" Visibility="Collapsed" />
      <Image Name="ImageConnected" Visibility="Collapsed" />
      <Path Name="chevroncircle" Visibility="Collapsed" />

      <!-- UserControls for Error, PopUp, Subscription, Favorites, Notifications -->
      <errors:ConnectionErrorControl x:Name="ConnectionError" Visibility="Collapsed" />
      <disclaimer:IpAddressRotationDisclaimerControl x:Name="IpAddressRotationDisclaimer" Visibility="Collapsed" />
      <trial:TrialFirstChips x:Name="TrialFirstChips" Visibility="Collapsed" />
      <connectionData:ConnectionData x:Name="ConnectionData" Visibility="Collapsed" />
      <accountPopUp:SubscriptionExpireSoonControl x:Name="SubscriptionExpireSoon" Visibility="Collapsed" />
      <Grid Name="chevronGrid" Visibility="Collapsed" />
      <local:Favorite_LocationsControl x:Name="PrivateFavoriteLocationControl" Visibility="Collapsed" />
      <streamingFavorite:FavoriteStreamingLocationsControl x:Name="StreamingFavoriteLocationControl" Visibility="Collapsed" />
      <feedbackPopUp:FeedbackPopUpControl x:Name="FeedbackPopUpControl" Visibility="Collapsed" />
      <splitTunnelingPopUp:SplitTunnelingReconnectPopUp x:Name="SplitTunnelingReconnectPopUp" Visibility="Collapsed" />
      <mainPanelNotification:MainPanelNotificationControl x:Name="MainPanelNotification" Visibility="Collapsed" />
    </Grid>
  </Grid>
</UserControl>