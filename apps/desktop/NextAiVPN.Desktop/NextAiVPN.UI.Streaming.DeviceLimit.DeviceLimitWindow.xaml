<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NextAiVPN.UI.Streaming.DeviceLimit.DeviceLimitWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="Window" Title="DeviceLimitWindow" Width="320" ResizeMode="NoResize" SizeToContent="Height" Style="{DynamicResource DeleteLogsMessageWindowBackgroundStyle}" WindowStartupLocation="CenterScreen" WindowStyle="None" xmlns:devicelimit="clr-namespace:NextAiVPN.UI.Streaming.DeviceLimit;assembly=NextAiVPN">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" />
  </WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0" Margin="16,16,0,0">
      <TextBlock FontSize="20" Style="{DynamicResource DeleteLogsMessageWindowTextBlockHeaderForegroundStyle}" Text="Device limit reached" />
      <Image Width="25" Height="25" Margin="0,0,16,0" HorizontalAlignment="Right" Style="{DynamicResource XCloseButtonWindowImageStyle}">
        <b:Interaction.Triggers>
          <b:EventTrigger EventName="MouseDown">
            <b:InvokeCommandAction Command="{Binding XCloseButtonMouseDownCommand}" CommandParameter="{Binding ElementName=Window}" />
          </b:EventTrigger>
        </b:Interaction.Triggers>
      </Image>
    </Grid>
    <TextBlock Grid.Row="1" Width="279" Height="Auto" Margin="16,6,0,0" HorizontalAlignment="Left" FontSize="14" Style="{DynamicResource DeleteLogsMessageWindowTextBlockForegroundStyle}" TextWrapping="Wrap" Text="{Binding Path=Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <StackPanel Grid.Row="2" Height="26" Margin="16,6,0,0" Orientation="Horizontal">
      <TextBlock Width="Auto" Height="Auto" HorizontalAlignment="Left" FontSize="14" Style="{DynamicResource DeleteLogsMessageWindowTextBlockForegroundStyle}" Text="Read" TextWrapping="Wrap" />
      <TextBlock Width="Auto" Height="Auto" Margin="5,0,0,0" HorizontalAlignment="Left" FontSize="14" Style="{DynamicResource LinksTextBlockStyle}" Text="Streaming rules" TextWrapping="Wrap">
        <b:Interaction.Triggers>
          <b:EventTrigger EventName="MouseDown">
            <b:InvokeCommandAction Command="{Binding StreamingRulesLinkMouseDownCommand}" />
          </b:EventTrigger>
        </b:Interaction.Triggers>
      </TextBlock>
    </StackPanel>
    <Button Grid.Row="3" Height="32" Margin="16,0,16,16" Content="I understand" Style="{DynamicResource OkButtonBindingTextStyle}" Command="{Binding XCloseButtonMouseDownCommand}" CommandParameter="{Binding ElementName=Window}" />
  </Grid>
</Window>