<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NextAiVPN.BeforeConnectWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:header="clr-namespace:NextAiVPN" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="NextAiVPN" Width="425" Height="675" Icon="/Assets/NextAiVPN/vpn_icon.ico" ResizeMode="CanMinimize" Style="{DynamicResource {x:Type Window}}" WindowStartupLocation="CenterScreen" Closing="Window_Closing" Loaded="BeforeConnectWindow_OnLoaded">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="34" />
  </WindowChrome.WindowChrome>
  <Grid>
    <StackPanel Orientation="Vertical">
      <header:WindowHeader x:Name="WindowHeader" />
      <TextBlock Margin="0,25,0,0" HorizontalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="30" Style="{DynamicResource BeforeConnectHeaderTextBlockStyle}" Text="Before you connect" />
      <Line Name="TopLine" HorizontalAlignment="Center" VerticalAlignment="Top" Stroke="{StaticResource ColorDBDBE3}" StrokeThickness="1" Visibility="Collapsed" X1="0" X2="450" Y1="20" Y2="20" />
      <TextBlock Name="TopText" Margin="30,35,30,0" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="14" LineHeight="20" Style="{DynamicResource BeforeConnectTextBlockStyle}" Text="Your privacy is our top priority. We are transparent about the data we collect and we can assure you that we only collect the minimum amount possible to provide with you with a smooth and stable VPN experience:" TextWrapping="Wrap" />
      <BulletDecorator Margin="30,20,30,0">
        <BulletDecorator.Bullet>
          <Ellipse Width="5" Height="5" Fill="{StaticResource Color848487}" />
        </BulletDecorator.Bullet>
        <TextBlock Name="Bullet1" Margin="10,0,0,0" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="14" LineHeight="20" Style="{DynamicResource BeforeConnectTextBlockStyle}" Text="Email Address: for sign in purposes and to allow you to retrieve your password and receive service updates." TextWrapping="Wrap" />
      </BulletDecorator>
      <BulletDecorator Margin="30,20,30,0">
        <BulletDecorator.Bullet>
          <Ellipse Width="5" Height="5" Fill="{StaticResource Color848487}" />
        </BulletDecorator.Bullet>
        <TextBlock Name="Bullet2" Margin="10,0,0,0" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="14" LineHeight="20" Style="{DynamicResource BeforeConnectTextBlockStyle}" Text="Aggregated anonymous app usage data, including your device and OS version so we can troubleshoot and improve our app." TextWrapping="Wrap" />
      </BulletDecorator>
      <TextBlock Name="bottomText" Margin="30,20,30,32" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="14" Style="{DynamicResource BeforeConnectTextBlockStyle}" Text="That's it! No logs. No tracking of your personal identifiable information." TextWrapping="Wrap" />
      <Button Name="IUnderstand" Width="339" Height="64" Margin="0,95,40,0" HorizontalAlignment="Right" Content="I understand" Style="{DynamicResource BtnSignInButtonStyle}" Click="IUnderstand_Click" />
    </StackPanel>
  </Grid>
</Window>