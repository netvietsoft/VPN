<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.Feedback.PopUp.FeedbackPopUpControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:NextAiVPN.UI.Feedback.PopUp" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Width="414" Style="{DynamicResource MainPanelNotificationUserControlStyle}" Height="{Binding Path=UserControlHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Path=UserControlVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
  <StackPanel>
    <Border BorderBrush="{DynamicResource ColorF4F4F5}" BorderThickness="0.1">
      <UIElement.Effect>
        <DropShadowEffect ShadowDepth="-2" Color="Gray" />
      </UIElement.Effect>
    </Border>
    <StackPanel Name="FeedbackTopPanel" VerticalAlignment="Top" Orientation="Horizontal">
      <Image Name="MessageImage" Width="35" Height="35" Margin="15,0,0,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" Style="{DynamicResource FeedbackPopUpImageStyle}" />
      <StackPanel Orientation="Vertical">
        <TextBlock Name="Howarewedoing" Width="314" Margin="10,18,0,18" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" FontWeight="SemiBold" Style="{DynamicResource GeneralExpendedTextBlockStyle}" Text="How are we doing?" />
        <StackPanel>
          <TextBlock Width="236" Margin="10,-15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="{DynamicResource MuseoSans400FontFamily}" Style="{DynamicResource ProtocolInfoTextBlockStyle}" Text="Let us know what you think of NextAiVPN. Tell us more " TextWrapping="Wrap" />
          <TextBlock Width="50" Margin="82,-15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="{DynamicResource MuseoSans400FontFamily}" Style="{DynamicResource LinksTextBlockStyle}" Text="here." TextWrapping="Wrap">
            <b:Interaction.Triggers>
              <b:EventTrigger EventName="MouseDown">
                <b:InvokeCommandAction Command="{Binding TextBlockLinkClickCommand}" />
              </b:EventTrigger>
            </b:Interaction.Triggers>
          </TextBlock>
        </StackPanel>
      </StackPanel>
      <Image Name="FeedbackClose" Height="25" Margin="-5,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource XCloseButtonWindowImageStyle}">
        <b:Interaction.Triggers>
          <b:EventTrigger EventName="MouseDown">
            <b:InvokeCommandAction Command="{Binding CloseButtonClickCommand}" />
          </b:EventTrigger>
        </b:Interaction.Triggers>
      </Image>
    </StackPanel>
    <StackPanel Name="FeedbackBottomPanel" HorizontalAlignment="Center" Orientation="Vertical" Visibility="{Binding Path=ButtonsVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
      <Button Name="RemindMeLater" Width="300" Height="32" Margin="0,12,0,0" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Content="Remind me later" Style="{DynamicResource WhiteButtonStyle}" Command="{Binding RemindMeLaterClickCommand}" />
      <Button Name="DontAskAgain" Width="300" Height="32" Margin="0,12,0,12" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Content="Don't ask again" Style="{DynamicResource WhiteButtonStyle}" Command="{Binding DontAskAgainClickCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>