<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.Favotite.FavoriteLocationsTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:favotite="clr-namespace:NextAiVPN.UI.Favotite" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="clr-namespace:NextAiVPN.UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:LocationsListHeader x:Name="LocationsListHeader" Height="40" />
    <Separator Width="Auto" Margin="0,0,0,2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Foreground="#FFD3D3D3" Opacity="0.2" />
    <Grid Row="1" Margin="0,0,0,0" DockPanel.Dock="Bottom">
      <ListBox Name="LocationsList" Width="570" Height="485" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0" FontFamily="{DynamicResource MuseoSans500FontFamily}" IsEnabled="True" ItemContainerStyle="{DynamicResource FavoriteLocationListBoxItemStyle}" RenderTransformOrigin="0.316,0.472" ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Auto" Loaded="LocationsList_OnLoaded">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="560">
              <favotite:FavoriteLocationListItem PreviewMouseLeftButtonDown="FavoriteLocationListItem_OnMouseDown" DataContext="{Binding}" Tag="{Binding RelativeSource={RelativeSource AncestorType={x:Type favotite:FavoriteLocationsTab}}}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type ListBox}}" TargetType="{x:Type ListBox}">
            <Style.Triggers>
              <Trigger Property="ItemsControl.HasItems" Value="False">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate>
                      <TextBlock Name="NoLocations" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="12" Opacity="0.4" Style="{DynamicResource DefaultTextBlockForegroundStyle}" Text="{Binding Path=NoServersFoundMessage}" />
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>