<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.MainPanelConnectionData.ConnectionData" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mainPanelConnectionData="clr-namespace:NextAiVPN.UI.MainPanelConnectionData" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Visibility="{Binding Path=ControlVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80" />
      <ColumnDefinition Width="80" />
      <ColumnDefinition Width="80" />
    </Grid.ColumnDefinitions>
    <StackPanel Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
      <StackPanel Margin="0 0 0 5" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
        <TextBlock Margin="0 2 0 0" FontSize="10" Foreground="{StaticResource Color6D6E70}" Text="IP ADDRESS" />
        <Image Width="14" Height="14" Margin="5,0,0,0" Source="{Binding IpAddressInfoImageSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <b:Interaction.Triggers>
            <b:EventTrigger EventName="MouseDown">
              <b:InvokeCommandAction Command="{Binding IpAddressInfoClickCommand}" />
            </b:EventTrigger>
          </b:Interaction.Triggers>
        </Image>
      </StackPanel>
      <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Style="{DynamicResource ConnectedImprovementsInfoValuesTextBlockStyle}" Text="{Binding Path=IpAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Style="{DynamicResource LinksTextBlockStyle}" Text="Switch IP" Visibility="{Binding Path=ShuffleIpVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
        <b:Interaction.Triggers>
          <b:EventTrigger EventName="MouseDown">
            <b:InvokeCommandAction Command="{Binding ShuffleIpClickCommand}" />
          </b:EventTrigger>
        </b:Interaction.Triggers>
      </TextBlock>
    </StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0" Orientation="Vertical">
      <Image Width="16" Height="16" Margin="0,7,0,0" Style="{DynamicResource StatisticDataDownloadImageStyle}" />
      <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Style="{DynamicResource ConnectedImprovementsInfoValuesTextBlockStyle}" Text="{Binding Path=NetworkUsageDownloadMb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Orientation="Vertical">
      <Image Width="16" Height="16" Margin="0,7,0,0" Style="{DynamicResource StatisticDataUploadImageStyle}" />
      <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Style="{DynamicResource ConnectedImprovementsInfoValuesTextBlockStyle}" Text="{Binding Path=NetworkUsageUploadMb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0" Orientation="Vertical">
      <Image Width="16" Height="16" Margin="0,7,0,0" Style="{DynamicResource StatisticConnectionProtocolImageStyle}" />
      <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Style="{DynamicResource ConnectedImprovementsInfoValuesTextBlockStyle}" Text="{Binding Path=Protocol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>

    <!-- Daily 300MB Quota Meter -->
    <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0" Padding="8,4" Background="{StaticResource BrushEmerald50}" BorderBrush="{StaticResource BrushBorderEmerald}" BorderThickness="1" CornerRadius="6">
      <StackPanel Orientation="Vertical">
        <Grid>
          <TextBlock FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushEmerald700}" Text="DAILY QUOTA (300 MB)" />
          <TextBlock HorizontalAlignment="Right" FontSize="9" Foreground="{StaticResource Color6D6E70}" Text="Resets 00:00 UTC" />
        </Grid>
        <Border Height="4" Margin="0,3,0,0" Background="{StaticResource BrushBorderSubtle}" CornerRadius="2">
          <Border Width="65" HorizontalAlignment="Left" Background="{StaticResource BrushEmerald600}" CornerRadius="2" />
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>