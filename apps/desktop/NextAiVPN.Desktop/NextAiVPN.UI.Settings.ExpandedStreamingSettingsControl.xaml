<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.Settings.ExpandedStreamingSettingsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:NextAiVPN.UI.Settings" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:nextaitechnologyVpn="clr-namespace:NextAiVPN">
  <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Auto">
    <b:Interaction.Triggers>
      <b:EventTrigger EventName="PreviewMouseWheel">
        <b:InvokeCommandAction PassEventArgsToCommand="True" Command="{Binding PreviewMouseWheelCommand}" />
      </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid Margin="16,0,0,16" VerticalAlignment="Top">
      <StackPanel Margin="0,24,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*" />
            <ColumnDefinition Width="0.5*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" Style="{DynamicResource GeneralExpendedTextBlockStyle}" Text="{Binding Title}" />
          <nextaitechnologyVpn:ToggleSwitch x:Name="SplitTunnelingSwitch" Grid.Column="1" Width="65" Height="25" Margin="0,0,30,0" HorizontalAlignment="Right" VerticalAlignment="Center">
            <b:Interaction.Triggers>
              <b:EventTrigger EventName="MouseDown">
                <b:InvokeCommandAction Command="{Binding SplitTunnelingToggleMouseDown}" CommandParameter="{Binding ElementName=SplitTunnelingSwitch}" />
              </b:EventTrigger>
            </b:Interaction.Triggers>
          </nextaitechnologyVpn:ToggleSwitch>
        </Grid>
        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
          <TextBlock Width="400" HorizontalAlignment="Left" FontSize="12" LineHeight="19" Style="{DynamicResource ProtocolInfoTextBlockStyle}" TextWrapping="Wrap" Text="{Binding Description}" />
          <TextBlock Width="100" Margin="-86,0,0,0" FontSize="12" LineHeight="19" Style="{DynamicResource LinksTextBlockStyle}" TextWrapping="Wrap" IsEnabled="{Binding IsManageButtonActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Text="{Binding SplitTunnelingTextButtonText}" Visibility="{Binding ManageButtonVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <b:Interaction.Triggers>
            <b:EventTrigger EventName="MouseDown">
              <b:InvokeCommandAction Command="{Binding OpenSplitTunnelingSettings}" />
            </b:EventTrigger>
          </b:Interaction.Triggers>
        </StackPanel>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>