<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.SplitTunneling.SplitTunnelingMainControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:circleCounter="clr-namespace:NextAiVPN.UI.Controls.CircleCounter" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Width="360" Height="280" xmlns:splittunneling="clr-namespace:NextAiVPN.UI.SplitTunneling">
  <DockPanel>
    <Grid Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0">
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" Style="{DynamicResource GeneralExpendedTextBlockStyle}" Text="{Binding Title}" />
        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Left" FontSize="12" LineHeight="19" Style="{DynamicResource ProtocolInfoTextBlockStyle}" TextWrapping="Wrap" Text="{Binding Description}" />
      </StackPanel>
      <Border Grid.Row="1" Margin="0,8,0,0" Style="{DynamicResource SplitTunnelingBorderStyle}">
        <b:Interaction.Triggers>
          <b:EventTrigger EventName="MouseLeftButtonDown">
            <b:InvokeCommandAction Command="{Binding AppClickCommand}" />
          </b:EventTrigger>
        </b:Interaction.Triggers>
        <Grid Margin="5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58*" />
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="14*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Grid.ColumnSpan="2">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" Style="{DynamicResource GeneralExpendedTextBlockStyle}" Text="{Binding AppTitle}" />
            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Left" FontSize="12" LineHeight="19" Style="{DynamicResource ProtocolInfoTextBlockStyle}" TextWrapping="Wrap" Text="{Binding AppDescription}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <circleCounter:CircleCounterControl x:Name="AppCounterControl" />
            <Image Width="20" Height="20" Margin="10,0,0,0" Style="{DynamicResource SplitTunnelingArrowRightImageStyle}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="2" Margin="0,8,0,0" Style="{DynamicResource SplitTunnelingBorderStyle}">
        <b:Interaction.Triggers>
          <b:EventTrigger EventName="MouseLeftButtonDown">
            <b:InvokeCommandAction Command="{Binding HostnameClickCommand}" />
          </b:EventTrigger>
        </b:Interaction.Triggers>
        <Grid Margin="5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58*" />
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="14*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Grid.ColumnSpan="2">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" Style="{DynamicResource GeneralExpendedTextBlockStyle}" Text="{Binding HostnameTitle}" />
            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Left" FontSize="12" LineHeight="19" Style="{DynamicResource ProtocolInfoTextBlockStyle}" TextWrapping="Wrap" Text="{Binding HostnameDescription}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <circleCounter:CircleCounterControl x:Name="DomainCounterControl" />
            <Image Width="20" Height="20" Margin="10,0,0,0" Style="{DynamicResource SplitTunnelingArrowRightImageStyle}" />
          </StackPanel>
        </Grid>
      </Border>
      <Button Grid.Row="3" Width="68" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom" Content="Close" Style="{DynamicResource OkButtonBindingTextStyle}" Command="{Binding CloseButtonClickCommand}" />
    </Grid>
  </DockPanel>
</UserControl>