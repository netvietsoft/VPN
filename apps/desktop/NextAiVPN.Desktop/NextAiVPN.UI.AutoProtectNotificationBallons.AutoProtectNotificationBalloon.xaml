<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.AutoProtectNotificationBallons.AutoProtectNotificationBalloon" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:autoprotectnotificationballons="clr-namespace:NextAiVPN.UI.AutoProtectNotificationBallons;assembly=NextAiVPN" Visibility="{Binding Path=UserControlVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
  <Grid Width="420" Height="135" Style="{DynamicResource NotificationBackgroundGridStyle}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0.15*" />
      <ColumnDefinition Width="0.85*" />
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="1" Margin="0,0,25,82" HorizontalAlignment="Right" Orientation="Horizontal">
      <Image Width="25" Height="25" Style="{DynamicResource ThreeHorizontalDotsImageStyle}">
        <b:Interaction.Triggers>
          <b:EventTrigger EventName="MouseDown">
            <b:InvokeCommandAction Command="{Binding ContextMenuClickCommand}" />
          </b:EventTrigger>
        </b:Interaction.Triggers>
      </Image>
      <Image Width="25" Height="25" Style="{DynamicResource XCloseButtonWindowImageStyle}">
        <b:Interaction.Triggers>
          <b:EventTrigger EventName="MouseDown">
            <b:InvokeCommandAction Command="{Binding CloseButtonClickCommand}" />
          </b:EventTrigger>
        </b:Interaction.Triggers>
      </Image>
    </StackPanel>
    <Image Grid.Column="0" Width="25" Height="25" Margin="0,20,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" Source="{Binding Path=ImageSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <StackPanel Grid.Column="1" Width="315" Height="auto" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
      <TextBlock Width="Auto" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="{DynamicResource MuseoSans600FontFamily}" FontSize="20" FontWeight="Bold" Style="{DynamicResource NotificationTextHeaderForegroundTextBlockStyle}" Text="{Binding Path=Header, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock VerticalAlignment="Top" FontFamily="{DynamicResource MuseoSans400FontFamily}" FontSize="14" Style="{DynamicResource NotificationTextForegroundTextBlockStyle}" TextWrapping="Wrap" Text="{Binding Path=Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <StackPanel Margin="0,10,0,0" HorizontalAlignment="Left" Orientation="Horizontal">
        <Button Width="150" Height="32.6" Content="Connect to VPN" Style="{DynamicResource OkButtonBindingTextStyle}" Command="{Binding ConnectToVpnClickCommand}" />
        <Button Width="150" Height="32.6" Margin="5,0,0,0" Style="{DynamicResource TrustThisNetworkNotificationButtonStyle}" Command="{Binding AddTrustedNetworkClickCommand}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>