<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.SendFeedbackButtonControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="clr-namespace:NextAiVPN.UI;assembly=NextAiVPN">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="SendFeedbackButton1" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="148" />
        <Setter Property="Background" Value="{DynamicResource ColorFFAB33}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate>
              <Border Name="btnBorder" Width="{TemplateBinding FrameworkElement.Width}" Height="{TemplateBinding FrameworkElement.Height}" Background="{TemplateBinding Control.Background}" BorderThickness="0" CornerRadius="24">
                <Grid>
                  <Image Name="Emoji" Width="24" Height="24" Panel.ZIndex="99" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
                  <Grid Name="FeedbackGridGrid" Margin="25,0,0,0" Visibility="Visible">
                    <Image Name="SendFeedbackImage" Width="17" Height="17" Margin="-106,0,0,0" RenderOptions.BitmapScalingMode="HighQuality" Source="/Assets/SendFeedbackIcon.png" />
                    <TextBlock Margin="20,10,0,0" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFFFF" Text="Feedback" />
                  </Grid>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#FFFFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Button Name="SendFeedbackBtn" Width="148" Height="40" Style="{DynamicResource SendFeedbackButtonStyle}" MouseEnter="SendFeedbackBtn_OnMouseEnter" MouseLeave="SendFeedbackBtn_OnMouseLeave">
      <UIElement.Effect>
        <DropShadowEffect Opacity="0.2" ShadowDepth="2" />
      </UIElement.Effect>
    </Button>
  </Grid>
</UserControl>