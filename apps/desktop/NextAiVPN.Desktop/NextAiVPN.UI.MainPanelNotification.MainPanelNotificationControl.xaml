<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.MainPanelNotification.MainPanelNotificationControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Style="{DynamicResource MainPanelNotificationUserControlStyle}" xmlns:mainpanelnotification="clr-namespace:NextAiVPN.UI.MainPanelNotification;assembly=NextAiVPN" Visibility="{Binding Path=UserControlVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
  <Grid>
    <Border BorderBrush="{DynamicResource ColorF4F4F5}" BorderThickness="0.1">
      <UIElement.Effect>
        <DropShadowEffect ShadowDepth="-2" Color="Gray" />
      </UIElement.Effect>
    </Border>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Margin="24,24,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" Style="{DynamicResource GeneralExpendedTextBlockStyle}" Text="Connection Support" />
      <Image Grid.Column="1" Width="25" Height="25" Margin="58,0,-300,15" Style="{DynamicResource XCloseButtonWindowImageStyle}">
        <b:Interaction.Triggers>
          <b:EventTrigger EventName="MouseDown">
            <b:InvokeCommandAction Command="{Binding CloseButtonClickCommand}" />
          </b:EventTrigger>
        </b:Interaction.Triggers>
      </Image>
      <TextBlock Grid.Row="1" Margin="24,0,149,24" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="12" Style="{DynamicResource ProtocolInfoTextBlockStyle}" Text="Seems like you're having some problems. Tell us more by clicking " TextWrapping="Wrap" />
      <TextBlock Grid.Row="1" Margin="158,15,0,0" FontFamily="{DynamicResource MuseoSans500FontFamily}" Style="{DynamicResource LinksTextBlockStyle}" Text="here">
        <b:Interaction.Triggers>
          <b:EventTrigger EventName="MouseDown">
            <b:InvokeCommandAction Command="{Binding TextBlockLinkClickCommand}" />
          </b:EventTrigger>
        </b:Interaction.Triggers>
      </TextBlock>
    </Grid>
  </Grid>
</UserControl>