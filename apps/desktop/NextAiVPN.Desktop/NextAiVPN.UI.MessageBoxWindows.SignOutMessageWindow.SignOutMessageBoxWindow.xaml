<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NextAiVPN.UI.MessageBoxWindows.SignOutMessageWindow.SignOutMessageBoxWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="SignOutMessageBoxWindow" Width="350" Height="160" Style="{DynamicResource DeleteLogsMessageWindowBackgroundStyle}" WindowStartupLocation="CenterScreen" WindowStyle="None" xmlns:signoutmessagewindow="clr-namespace:NextAiVPN.UI.MessageBoxWindows.SignOutMessageWindow;assembly=NextAiVPN" Visibility="{Binding ParentWindowVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" />
  </WindowChrome.WindowChrome>
  <DockPanel>
    <Grid>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Width="Auto" Height="24" Margin="24,25,0,0" HorizontalAlignment="Left" FontSize="20" Style="{DynamicResource DeleteLogsMessageWindowTextBlockHeaderForegroundStyle}" Text="{Binding Path=Title}" />
        </StackPanel>
        <TextBlock Width="Auto" Height="Auto" Margin="24,7,0,0" HorizontalAlignment="Left" FontSize="12" Style="{DynamicResource DeleteLogsMessageWindowTextBlockForegroundStyle}" Text="{Binding Description}" />
        <StackPanel Margin="16,25,16,0" HorizontalAlignment="Center" Background="#00FFFFFF" Orientation="Horizontal">
          <Button Width="134" Height="32" Margin="0,0,2,0" Content="Cancel" Style="{DynamicResource CancelButtonBindingTextStyle}" Command="{Binding CancelButtonClickCommand}" />
          <Button Width="134" Height="32" Margin="2,0,0,0" Content="Yes, Sign Out" Style="{DynamicResource OkButtonBindingTextStyle}" Command="{Binding YesButtonClickCommand}" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>