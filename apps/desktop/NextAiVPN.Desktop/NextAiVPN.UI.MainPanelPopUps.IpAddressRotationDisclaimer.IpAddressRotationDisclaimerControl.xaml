<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.MainPanelPopUps.IpAddressRotationDisclaimer.IpAddressRotationDisclaimerControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:ipAddressRotationDisclaimer="clr-namespace:NextAiVPN.UI.MainPanelPopUps.IpAddressRotationDisclaimer" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Style="{DynamicResource MainPanelNotificationUserControlStyle}" Visibility="{Binding Path=ControlVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
  <Grid>
    <Border BorderBrush="{DynamicResource ColorF4F4F5}" BorderThickness="0.1">
      <UIElement.Effect>
        <DropShadowEffect ShadowDepth="-2" Color="{DynamicResource Color575758}" />
      </UIElement.Effect>
    </Border>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Image Width="25" Height="25" Margin="0,20,20,0" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="15" Style="{DynamicResource XCloseButtonWindowImageStyle}">
        <b:Interaction.Triggers>
          <b:EventTrigger EventName="MouseDown">
            <b:InvokeCommandAction Command="{Binding CloseButtonClickCommand}" />
          </b:EventTrigger>
        </b:Interaction.Triggers>
      </Image>
      <TextBlock Grid.Row="0" Margin="20,10,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" Style="{DynamicResource GeneralExpendedTextBlockStyle}" Text="{Binding Title}" />
      <TextBlock Grid.Row="1" Margin="20,10,0,20" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="12" Style="{DynamicResource ProtocolInfoTextBlockStyle}" TextWrapping="Wrap" Text="{Binding Description}" />
    </Grid>
  </Grid>
</UserControl>