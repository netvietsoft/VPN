<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.AllLocations.AllLocationsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:NextAiVPN.UI.AllLocations" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="clr-namespace:NextAiVPN.UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:LocationsListHeader x:Name="LocationsListHeader" />
    <Separator Grid.ColumnSpan="8" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Foreground="#FFD3D3D3" Opacity="0.2" />
    <ListBox Name="LocationsList" Grid.Row="1" Width="570" Height="510" Padding="0,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0" FontFamily="{DynamicResource MuseoSans500FontFamily}" IsEnabled="True" ItemContainerStyle="{DynamicResource FavoriteLocationListBoxItemStyle}" RenderTransformOrigin="0.316,0.472" ScrollViewer.CanContentScroll="False" ScrollViewer.VerticalScrollBarVisibility="Auto" Loaded="LocationsList_OnLoaded" PreviewMouseWheel="LocationsList_OnPreviewMouseWheel" SelectionChanged="LocationsList_OnSelectionChanged">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <local:AllLocationListItem x:Name="AllLocationListItem" HorizontalAlignment="Stretch" DataContext="{Binding}" Tag="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:AllLocationsControl}}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type ListBox}}" TargetType="{x:Type ListBox}">
          <Style.Triggers>
            <Trigger Property="ItemsControl.HasItems" Value="False">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate>
                    <TextBlock Name="NoLocations" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans500FontFamily}" FontSize="12" Opacity="0.4" Style="{DynamicResource DefaultTextBlockForegroundStyle}" Text="No servers found matching that name." />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Trigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </ListBox>
  </Grid>
</UserControl>