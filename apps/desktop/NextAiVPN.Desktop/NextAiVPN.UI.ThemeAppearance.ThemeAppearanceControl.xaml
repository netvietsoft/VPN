<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.ThemeAppearance.ThemeAppearanceControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:themeappearance="clr-namespace:NextAiVPN.UI.ThemeAppearance;assembly=NextAiVPN">
  <b:Interaction.Triggers>
    <b:EventTrigger EventName="Loaded">
      <b:InvokeCommandAction Command="{Binding LoadedCommand}" />
    </b:EventTrigger>
  </b:Interaction.Triggers>
  <Grid>
    <StackPanel Margin="0,24,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.5*" />
          <ColumnDefinition Width="0.5*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource MuseoSans700FontFamily}" FontSize="16" Style="{DynamicResource GeneralExpendedTextBlockStyle}" Text="Theme Appearance" />
      </Grid>
      <StackPanel Margin="0,6,0,0">
        <TextBlock Width="400" HorizontalAlignment="Left" FontSize="12" LineHeight="19" Style="{DynamicResource ProtocolInfoTextBlockStyle}" Text="Select a light or dark background for your account." TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
        <Border Name="LightModeBorderSwitcher" Margin="24,0,0,0" Style="{DynamicResource StyleSwitcherBorderStyle}" BorderBrush="{Binding Path=LightColorBorderBrush, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <Image Name="LightModeSwitcher" Width="80" Height="48" Source="/Assets/ModeSwitcherLight.png">
            <b:Interaction.Triggers>
              <b:EventTrigger EventName="MouseLeftButtonDown">
                <b:InvokeCommandAction Command="{Binding LightModeButtonClickCommand}" />
              </b:EventTrigger>
            </b:Interaction.Triggers>
          </Image>
        </Border>
        <Border Name="DarkModeBorderSwitcher" Margin="16,0,0,0" Style="{DynamicResource StyleSwitcherBorderStyle}" BorderBrush="{Binding Path=DarkColorBorderBrush, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <Image Name="DarkModeSwitcher" Width="80" Height="48" Source="/Assets/ModeSwitcherDark.png">
            <b:Interaction.Triggers>
              <b:EventTrigger EventName="MouseLeftButtonDown">
                <b:InvokeCommandAction Command="{Binding DarkModeButtonClickCommand}" />
              </b:EventTrigger>
            </b:Interaction.Triggers>
          </Image>
        </Border>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>