<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NextAiVPN.UI.Feedback.DiscardChanges.DiscardChangesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="Discard Changes" Width="350" Height="160" Icon="/Assets/NextAiVPN/vpn_icon.ico" Style="{DynamicResource DeleteLogsMessageWindowBackgroundStyle}" WindowStartupLocation="CenterScreen" WindowStyle="None" xmlns:discardchanges="clr-namespace:NextAiVPN.UI.Feedback.DiscardChanges;assembly=NextAiVPN">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" />
  </WindowChrome.WindowChrome>
  <DockPanel>
    <Grid>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Width="Auto" Height="24" Margin="24,25,0,0" HorizontalAlignment="Left" FontSize="20" Style="{DynamicResource DeleteLogsMessageWindowTextBlockHeaderForegroundStyle}" Text="Discard Changes?" />
          <Image Width="25" Height="25" Margin="130,10,0,10" Style="{DynamicResource XCloseButtonWindowImageStyle}">
            <b:Interaction.Triggers>
              <b:EventTrigger EventName="MouseDown">
                <b:InvokeCommandAction Command="{Binding CloseButtonClickCommand}" />
              </b:EventTrigger>
            </b:Interaction.Triggers>
          </Image>
        </StackPanel>
        <TextBlock Width="Auto" Height="Auto" Margin="24,7,0,0" HorizontalAlignment="Left" FontSize="12" Style="{DynamicResource DeleteLogsMessageWindowTextBlockForegroundStyle}" Text="If you discard now, your changes will be lost. Do you want to leave without saving?" TextWrapping="Wrap" />
        <StackPanel Margin="16,25,16,0" HorizontalAlignment="Center" Background="#00FFFFFF" Orientation="Horizontal">
          <Button Width="134" Height="32" Margin="0,0,2,0" Content="Cancel" Style="{DynamicResource CancelButtonBindingTextStyle}" Command="{Binding CloseButtonClickCommand}" />
          <Button Width="134" Height="32" Margin="2,0,0,0" Content="Discard" Style="{DynamicResource DiscardChangesButtonBindingTextStyle}" Command="{Binding YesButtonClickCommand}" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>