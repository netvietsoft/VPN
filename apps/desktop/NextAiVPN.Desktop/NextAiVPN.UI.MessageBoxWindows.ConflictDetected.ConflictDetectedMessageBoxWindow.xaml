<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NextAiVPN.UI.MessageBoxWindows.ConflictDetected.ConflictDetectedMessageBoxWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="ConflictDetectedMessageBoxWindow" Width="340" ResizeMode="NoResize" Style="{DynamicResource DeleteLogsMessageWindowBackgroundStyle}" WindowStartupLocation="CenterScreen" WindowStyle="None" xmlns:conflictdetected="clr-namespace:NextAiVPN.UI.MessageBoxWindows.ConflictDetected;assembly=NextAiVPN" Height="{Binding WindowHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding WindowVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" />
  </WindowChrome.WindowChrome>
  <DockPanel>
    <Grid>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Width="Auto" Height="24" Margin="24,25,0,0" HorizontalAlignment="Left" FontSize="20" Style="{DynamicResource DeleteLogsMessageWindowTextBlockHeaderForegroundStyle}" Text="{Binding Path=Title}" />
          <Image Width="25" Height="25" Margin="108,10,0,10" Style="{DynamicResource XCloseButtonWindowImageStyle}">
            <b:Interaction.Triggers>
              <b:EventTrigger EventName="MouseDown">
                <b:InvokeCommandAction Command="{Binding CancelButtonClickCommand}" />
              </b:EventTrigger>
            </b:Interaction.Triggers>
          </Image>
        </StackPanel>
        <TextBlock Width="302" Height="Auto" Margin="18,7,0,0" HorizontalAlignment="Left" FontSize="12" Style="{DynamicResource DeleteLogsMessageWindowTextBlockForegroundStyle}" TextWrapping="Wrap" Text="{Binding Description}" />
        <StackPanel Margin="16,25,16,0" HorizontalAlignment="Center" Background="#00FFFFFF" Orientation="Vertical">
          <Button Width="305" Height="32" Margin="0,0,0,0" Style="{DynamicResource OkButtonBindingTextStyle}" Command="{Binding OkButtonClickCommand}" Content="{Binding OkButtonText}" />
          <Button Width="305" Height="32" Margin="0,10,0,0" Style="{DynamicResource CancelButtonBindingTextStyle}" Command="{Binding CancelButtonClickCommand}" Content="{Binding CancelButtonText}" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>