<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NextAiVPN.UI.AllLocations.AllLocationListItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:alllocations="clr-namespace:NextAiVPN.UI.AllLocations;assembly=NextAiVPN" DataContextChanged="AllLocationListItem_OnDataContextChanged">
  <Grid Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Name="CountryMainGrid" Margin="0" Background="Transparent" PreviewMouseLeftButtonDown="CountryMainGrid_OnPreviewMouseLeftButtonDown">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="50" />
      </Grid.ColumnDefinitions>
      <Border Name="LocationItemHoverBorder" Height="40" HorizontalAlignment="Stretch" Margin="2,0,2,0" VerticalAlignment="Center" CornerRadius="20" BorderThickness="1.5" BorderBrush="Transparent" Style="{DynamicResource SelectedLocationBorderStyle}" Cursor="Hand">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="105" />
            <ColumnDefinition Width="50" />
          </Grid.ColumnDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" ClipToBounds="True" BorderBrush="#25000000" BorderThickness="1.5">
            <Image Name="CountryFlag" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" Source="{Binding Path=CountryCode, Converter={StaticResource CountryCodeToFlagConverter}}" />
          </Border>
          <Grid Row="0" Column="1">
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Name="CountryName" VerticalAlignment="Center" Style="{DynamicResource LocationListBoxItemsTextForegroundTextBlockStyle}" Text="{Binding Country}" />
            <TextBlock Name="CityName" Grid.Row="1" VerticalAlignment="Center" Style="{DynamicResource LocationCityListBoxItemsTextForegroundTextBlockStyle}" Text="{Binding City}" />
          </Grid>
          <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource LocationListBoxItemsTextForegroundTextBlockStyle}" Text="{Binding Load, Converter={StaticResource LocationsLoadConverter}}" />
          <TextBlock Name="Ping" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource LocationListBoxItemsTextForegroundTextBlockStyle}" Text="{Binding PingMs, Converter={StaticResource AllLocationsPingConverter}}" />
          <Image Name="Favorite" Grid.Row="0" Grid.Column="4" Width="20" Height="20" Style="{DynamicResource FavoriteLocationImageStyle}" PreviewMouseLeftButtonDown="Favorite_OnPreviewMouseLeftButtonDown" MouseEnter="Favorite_OnMouseEnter" MouseLeave="Favorite_OnMouseLeave">
            <Image.Source>
              <MultiBinding Converter="{StaticResource LocationCountryToFavorite}">
                <Binding Path="Id" />
                <Binding Path="CountryCode" />
              </MultiBinding>
            </Image.Source>
          </Image>
        </Grid>
      </Border>
      <Grid Name="ExpanderGrid" Column="1" Visibility="Collapsed" Background="Transparent" Cursor="Hand" PreviewMouseLeftButtonDown="ExpanderGrid_OnPreviewMouseLeftButtonDown">
        <Ellipse Name="ExpanderHover" Grid.Row="0" Width="37" Height="37" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#00FFFFFF" MouseEnter="ExpanderHover_OnMouseEnter" MouseLeave="ExpanderHover_OnMouseLeave" />
        <Image Name="ExpanderImage" Grid.Row="0" Width="14" Height="14" Source="/Assets/carretdown.png" MouseEnter="ExpanderHover_OnMouseEnter" MouseLeave="ExpanderHover_OnMouseLeave" />
      </Grid>
    </Grid>
    <Grid Name="InnerLocationsGrid" Row="1" Column="0" Visibility="Collapsed">
      <ListBox Name="InnerLocationsList" Background="#00FFFFFF" BorderThickness="0" ItemContainerStyle="{DynamicResource FavoriteLocationListBoxItemStyle}" SelectionChanged="InnerLocationsList_OnSelectionChanged">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Name="InnerLocationItemHoverBorder" Height="40" Margin="15,2,5,2" HorizontalAlignment="Stretch" VerticalAlignment="Center" CornerRadius="20" BorderThickness="1.5" BorderBrush="Transparent" Style="{DynamicResource SelectedLocationBorderStyle}" Cursor="Hand" PreviewMouseLeftButtonDown="InnerLocationItem_OnPreviewMouseLeftButtonDown">
              <Grid Name="InnerLocationMainGrid">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="240" />
                  <ColumnDefinition Width="50" />
                  <ColumnDefinition Width="105" />
                  <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" ClipToBounds="True" BorderBrush="#25000000" BorderThickness="1.5">
                  <Image Name="CountryFlag" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" Source="{Binding Path=CountryCode, Converter={StaticResource CountryCodeToFlagConverter}}" />
                </Border>
                <Grid Name="LocationNameGrid" Row="0" Column="1" Margin="0,4,0,0">
                  <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                  </Grid.RowDefinitions>
                  <TextBlock Name="CityName" Style="{DynamicResource LocationListBoxItemsTextForegroundTextBlockStyle}" Text="{Binding City}" />
                  <TextBlock Name="CountryName" Grid.Row="1" Style="{DynamicResource LocationCityListBoxItemsTextForegroundTextBlockStyle}" Text="{Binding Country}" />
                </Grid>
                <TextBlock Name="Load" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource LocationListBoxItemsTextForegroundTextBlockStyle}" Text="{Binding Load, Converter={StaticResource LocationsLoadConverter}}" />
                <TextBlock Name="Ping" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource LocationListBoxItemsTextForegroundTextBlockStyle}" Text="{Binding PingMs, Converter={StaticResource AllLocationsPingConverter}}" />
                <Image Name="Favorite" Grid.Row="0" Grid.Column="4" Width="20" Height="20" Margin="0,0,0,0" HorizontalAlignment="Center" Style="{DynamicResource FavoriteLocationImageStyle}" Source="{Binding Path=Id, Converter={StaticResource LocationIdToFavorite}}" PreviewMouseLeftButtonDown="FavoriteCity_OnPreviewMouseLeftButtonDown" MouseEnter="Favorite_OnMouseEnter" MouseLeave="Favorite_OnMouseLeave" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>