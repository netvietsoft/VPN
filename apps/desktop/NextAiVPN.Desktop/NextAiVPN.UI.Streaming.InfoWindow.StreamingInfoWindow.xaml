<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NextAiVPN.UI.Streaming.InfoWindow.StreamingInfoWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:nextaitechnologyVpn="clr-namespace:NextAiVPN" Width="500" Height="504" ResizeMode="NoResize" Style="{DynamicResource StreamingInfoWindowStyle}" WindowStartupLocation="CenterOwner" xmlns:infowindow="clr-namespace:NextAiVPN.UI.Streaming.InfoWindow" Visibility="{Binding WindowVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="34" />
  </WindowChrome.WindowChrome>
  <DockPanel>
    <nextaitechnologyVpn:WindowHeader x:Name="WindowHeader" DockPanel.Dock="Top" />
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="55" />
        <RowDefinition Height="200" />
        <RowDefinition Height="70" />
        <RowDefinition Height="68" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal">
        <TextBlock Margin="16" Style="{DynamicResource StreamingInfoWindowTitleStyle}" Text="Streaming Mode" />
        <Border Width="32" Height="14" Margin="-8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="8" Style="{DynamicResource BetaInfoBorderStyle}">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource BetaInfoTextBlockStyle}" Text="BETA" />
        </Border>
      </StackPanel>
      <Image Grid.Row="1" RenderOptions.BitmapScalingMode="HighQuality" Source="/Assets/S_InfoIlustration.png" Stretch="Uniform" />
      <TextBlock Grid.Row="2" Margin="16" FontSize="13" Style="{DynamicResource StreamingInfoWindowTextBlockStyle}" Text="Enjoy streaming your favorite content with our specialized servers. Once you've tried our beta service, we'd value your feedback so we can improve." TextWrapping="Wrap" />
      <Border Grid.Row="3" Margin="16,0,16,0" Style="{DynamicResource StreamingInfoWindowBorderStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Grid.Column="0" Width="16" Height="16" Margin="9,11,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{DynamicResource StreamingInfoWindowWarringStyle}" />
          <StackPanel Grid.Column="1" Orientation="Vertical">
            <TextBlock Margin="0,8,0,0" Style="{DynamicResource StreamingInfoWindowWarringTitleTextBlockStyle}" Text="Streaming mode has limited features" />
            <TextBlock Margin="0,4,0,0" Style="{DynamicResource StreamingInfoWindowWarringTextBlockStyle}" Text="Some advanced settings are disabled when using 'For Streaming' servers. Switch back to 'All' servers to access advanced app features" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Row="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Width="230" Height="32" Content="Cancel" Style="{DynamicResource CancelButtonBindingTextStyle}" Visibility="Collapsed" Command="{Binding CloseCommand}" />
        <Button Grid.Column="0" Grid.ColumnSpan="2" Height="32" Margin="16,0" Content="Got it" Style="{DynamicResource OkButtonBindingTextStyle}" Command="{Binding ActivateCommand}" />
      </Grid>
    </Grid>
  </DockPanel>
</Window>