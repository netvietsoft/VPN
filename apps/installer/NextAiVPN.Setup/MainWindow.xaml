<Window x:Class="NextAiVPN.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài Đặt NextAI VPN Desktop &amp; Residential Gateway"
        Height="470" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Icon="app.ico"
        Background="#0B0F19"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" BorderThickness="0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B82F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="#334155" BorderThickness="1"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75" />
            <RowDefinition Height="*" />
            <RowDefinition Height="65" />
        </Grid.RowDefinitions>

        <!-- TOP BRAND HEADER -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="10" Background="#2563EB" Margin="0,0,14,0">
                        <TextBlock Text="🛡️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NextAI VPN Desktop Setup" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
                        <TextBlock Text="Residential Gateway Mesh Platform • Phiên bản v8.0.0" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="NextAi Technology" HorizontalAlignment="Right" VerticalAlignment="Center" 
                           FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Background="#0369A1" Padding="8,4" />
            </Grid>
        </Border>

        <!-- MAIN CONTENT CONTAINER (PAGES) -->
        <Grid Grid.Row="1" Margin="32,20">

            <!-- PAGE 1: WELCOME SCREEN -->
            <Grid x:Name="PageWelcome" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Margin="0,0,20,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="NextAI VPN" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" HorizontalAlignment="Center" />
                        <TextBlock Text="v8.0.0" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Chào mừng bạn đến với Trình Cài Đặt NextAI VPN!" 
                               FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="Phần mềm sẽ tiến hành cài đặt NextAI VPN Desktop Client cùng hệ thống Universal Proxy Gateway vào máy tính của bạn." 
                               FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,16" />

                    <Border Background="#131C31" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="• Tích hợp WireGuard &amp; Residential IP Harvester tự động." FontSize="12" Foreground="#CBD5E1" Margin="0,2" />
                            <TextBlock Text="• Kết nối Gateway Cổng 10000 chuẩn SOCKS5/HTTP cho KikiLogin." FontSize="12" Foreground="#CBD5E1" Margin="0,2" />
                            <TextBlock Text="• Bảo mật danh tính tối đa, hỗ trợ xoay IP và định tuyến thông minh." FontSize="12" Foreground="#CBD5E1" Margin="0,2" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Nhấn [Tiếp Tục] để bắt đầu quá trình thiết lập." FontSize="12" Foreground="#64748B" Margin="0,16,0,0" />
                </StackPanel>
            </Grid>

            <!-- PAGE 2: DIRECTORY & OPTIONS -->
            <Grid x:Name="PageOptions" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Chọn Vị Trí Cài Đặt Phần Mềm" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                    <TextBlock Text="Trình cài đặt sẽ cài NextAI VPN vào thư mục sau. Bạn có thể chọn thư mục khác:" 
                               FontSize="12" Foreground="#94A3B8" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtInstallPath" Grid.Column="0" Height="36" 
                                 Background="#131C31" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1"
                                 FontSize="13" Padding="10,8" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Duyệt..." Style="{StaticResource OutlineBtn}" 
                                Margin="8,0,0,0" Height="36" Click="BtnBrowse_Click" />
                    </Grid>

                    <TextBlock x:Name="TxtDiskSpace" Text="Dung lượng yêu cầu: ~85 MB | Ổ đĩa còn trống: Đang kiểm tra..." 
                               FontSize="11" Foreground="#64748B" Margin="0,0,0,16" />

                    <TextBlock Text="Tùy Chọn Lối Tắt &amp; Khởi Động:" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                    <Border Background="#131C31" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <StackPanel>
                            <CheckBox x:Name="ChkDesktopShortcut" Content="Tạo biểu tượng ngoài màn hình nền (Desktop Shortcut)" IsChecked="True" />
                            <CheckBox x:Name="ChkStartMenuShortcut" Content="Tạo lối tắt trong Start Menu (Programs > NextAI Technology)" IsChecked="True" />
                            <CheckBox x:Name="ChkRunOnStartup" Content="Tự động khởi động cùng Windows (Chạy ngầm dưới khay hệ thống)" IsChecked="False" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- PAGE 3: INSTALLATION PROGRESS -->
            <Grid x:Name="PageInstalling" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Đang Tiến Hành Cài Đặt NextAI VPN..." FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                    <TextBlock Text="Vui lòng chờ trong khi các tệp ứng dụng đang được trích xuất vào hệ thống." 
                               FontSize="12" Foreground="#94A3B8" Margin="0,0,0,24" />

                    <Border Background="#131C31" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Height="22" Padding="2" Margin="0,0,0,10">
                        <ProgressBar x:Name="InstallProgressBar" Minimum="0" Maximum="100" Value="0" 
                                     Background="Transparent" BorderThickness="0" Foreground="#2563EB" />
                    </Border>

                    <Grid Margin="0,0,0,12">
                        <TextBlock x:Name="TxtProgressStatus" Text="Chuẩn bị trích xuất tệp nhị phân..." FontSize="12" Foreground="#38BDF8" />
                        <TextBlock x:Name="TxtProgressPercent" Text="0%" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                    </Grid>

                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <TextBlock x:Name="TxtCurrentFile" Text="Ready..." FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- PAGE 4: FINISHED -->
            <Grid x:Name="PageFinished" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#064E3B" CornerRadius="12" Margin="0,0,20,0">
                    <TextBlock Text="✅" FontSize="52" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Cài Đặt NextAI VPN Hoàn Tất!" FontSize="20" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,8" />
                    <TextBlock Text="NextAI VPN Desktop &amp; Residential Gateway đã được cài đặt thành công vào máy tính của bạn." 
                               FontSize="13" Foreground="#94A3B8" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,18" />

                    <Border Background="#131C31" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="TxtFinishInstallPath" Text="Vị trí cài đặt: C:\Program Files\NextAiTechnology\NextAiVPN" 
                                       FontSize="12" Foreground="#38BDF8" TextWrapping="Wrap" Margin="0,2" />
                            <TextBlock Text="Universal Gateway Port: 10000 | Management CMS Port: 6033" FontSize="11" Foreground="#94A3B8" Margin="0,2" />
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="ChkLaunchApp" Content="Khởi chạy NextAI VPN Desktop ngay bây giờ" IsChecked="True" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>

        </Grid>

        <!-- BOTTOM BUTTON BAR -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Button x:Name="BtnCancel" Content="Hủy Bỏ" Style="{StaticResource OutlineBtn}" 
                        HorizontalAlignment="Left" VerticalAlignment="Center" Click="BtnCancel_Click" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnBack" Content="&lt; Quay Lại" Style="{StaticResource OutlineBtn}" 
                            Margin="0,0,10,0" Click="BtnBack_Click" Visibility="Collapsed" />
                    <Button x:Name="BtnNext" Content="Tiếp Tục &gt;" Style="{StaticResource ModernBtn}" 
                            Click="BtnNext_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
